@prefix myont: <https://ontologia.governanca.credito/myont#> .
@prefix schema: <https://schema.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    ÍNDICE PRÉ-PROCESSADO DE CONCEITOS EXTERNOS (Schema.org)
#################################################################

schema:AdministrativeArea rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "AdministrativeArea" ;
    rdfs:comment "A geographical region, typically under the jurisdiction of a particular government." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Place" .

schema:Airline rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Airline" ;
    rdfs:comment "An organization that provides flights for passengers." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:AnatomicalStructure rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "AnatomicalStructure" ;
    rdfs:comment "Any part of the human body, typically a component of an anatomical system. Organs, tissues, and cells are all anatomical structures." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:AnatomicalSystem rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "AnatomicalSystem" ;
    rdfs:comment "An anatomical system is a group of anatomical structures that work together to perform a certain task. Anatomical systems, such as organ systems, are one organizing principle of anatomy, and can include circulatory, digestive, endocrine, integumentary, immune, lymphatic, muscular, nervous, reproductive, respiratory, skeletal, urinary, vestibular, and other systems." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:ApartmentComplex rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "ApartmentComplex" ;
    rdfs:comment "Residence type: Apartment complex." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Residence" .

schema:BankAccount rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "BankAccount" ;
    rdfs:comment "A product or service offered by a bank whereby one may deposit, withdraw or transfer money and in some cases be paid interest." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:FinancialProduct" .

schema:BankOrCreditUnion rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "BankOrCreditUnion" ;
    rdfs:comment "Bank or credit union." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:FinancialService" .

schema:Barcode rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Barcode" ;
    rdfs:comment "An image of a visual machine-readable code such as a barcode or QR code." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:ImageObject" .

schema:BefriendAction rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "BefriendAction" ;
    rdfs:comment "The act of forming a personal connection with someone (object) mutually/bidirectionally/symmetrically.\\\\n\\\\nRelated actions:\\\\n\\\\n* FollowAction: Unlike FollowAction, BefriendAction implies that the connection is reciprocal." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:InteractAction" .

schema:BlogPosting rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "BlogPosting" ;
    rdfs:comment "A blog post." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:SocialMediaPosting" .

schema:BuyAction rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "BuyAction" ;
    rdfs:comment "The act of giving money to a seller in exchange for goods or services rendered. An agent buys an object, product, or service from a seller for a price. Reciprocal of SellAction." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:TradeAction" .

schema:CivicStructure rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "CivicStructure" ;
    rdfs:comment "A public structure, such as a town hall or concert hall." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Place" .

schema:Consortium rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Consortium" ;
    rdfs:comment "A Consortium is a membership Organization whose members are typically Organizations." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:Cooperative rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Cooperative" ;
    rdfs:comment "An organization that is a joint project of multiple organizations or persons." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:Corporation rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Corporation" ;
    rdfs:comment "Organization: A business corporation." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:CreditCard rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "CreditCard" ;
    rdfs:comment "A card payment method of a particular brand or name. Used to mark up a particular payment method and/or the financial product/service that supplies the card account.\\\\n\\\\nCommonly used values:\\\\n\\\\n* http://purl.org/goodrelations/v1#AmericanExpress\\\\n* http://purl.org/goodrelations/v1#DinersClub\\\\n* http://purl.org/goodrelations/v1#Discover\\\\n* http://purl.org/goodrelations/v1#JCB\\\\n* http://purl.org/goodrelations/v1#MasterCard\\\\n* http://purl.org/goodrelations/v1#VISA" ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:LoanOrCredit, schema:PaymentCard" .

schema:CurrencyConversionService rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "CurrencyConversionService" ;
    rdfs:comment "A service to convert funds from one currency to another currency." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:FinancialProduct" .

schema:DepositAccount rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "DepositAccount" ;
    rdfs:comment "A type of Bank Account with a main purpose of depositing funds to gain interest or other benefits." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:BankAccount, schema:InvestmentOrDeposit" .

schema:DiscussionForumPosting rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "DiscussionForumPosting" ;
    rdfs:comment "A posting to a discussion forum." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:SocialMediaPosting" .

schema:DrugClass rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "DrugClass" ;
    rdfs:comment "A class of medical drugs, e.g., statins. Classes can represent general pharmacological class, common mechanisms of action, common physiological effects, etc." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:DrugCost rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "DrugCost" ;
    rdfs:comment "The cost per unit of a medical drug. Note that this type is not meant to represent the price in an offer of a drug for sale; see the Offer type for that. This type will typically be used to tag wholesale or average retail cost of a drug, or maximum reimbursable cost. Costs of medical drugs vary widely depending on how and where they are paid for, so while this type captures some of the variables, costs should be used with caution by consumers of this schema's markup." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:EducationalOccupationalCredential rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "EducationalOccupationalCredential" ;
    rdfs:comment "An educational or occupational credential. A diploma, academic degree, certification, qualification, badge, etc., that may be awarded to a person or other entity that meets the requirements defined by the credentialer." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Credential" .

schema:EducationalOrganization rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "EducationalOrganization" ;
    rdfs:comment "An educational organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:CivicStructure, schema:Organization" .

schema:EmailMessage rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "EmailMessage" ;
    rdfs:comment "An email message." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Message" .

schema:EmployeeRole rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "EmployeeRole" ;
    rdfs:comment "A subclass of OrganizationRole used to describe employee relationships." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:OrganizationRole" .

schema:Female rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Female" ;
    rdfs:comment "The female gender." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Enumeração" ;
    myont:contextoExterno "tipo: schema:GenderType" .

schema:FinancialProduct rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "FinancialProduct" ;
    rdfs:comment "A product provided to consumers and businesses by financial institutions such as banks, insurance companies, brokerage firms, consumer finance companies, and investment companies which comprise the financial services industry." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Service" .

schema:FollowAction rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "FollowAction" ;
    rdfs:comment "The act of forming a personal connection with someone/something (object) unidirectionally/asymmetrically to get updates polled from.\\\\n\\\\nRelated actions:\\\\n\\\\n* BefriendAction: Unlike BefriendAction, FollowAction implies that the connection is *not* necessarily reciprocal.\\\\n* SubscribeAction: Unlike SubscribeAction, FollowAction implies that the follower acts as an active agent constantly/actively polling for updates.\\\\n* RegisterAction: Unlike RegisterAction, FollowAction implies that the agent is interested in continuing receiving updates from the object.\\\\n* JoinAction: Unlike JoinAction, FollowAction implies that the agent is interested in getting updates from the object.\\\\n* TrackAction: Unlike TrackAction, FollowAction refers to the polling of updates of all aspects of animate objects rather than the location of inanimate objects (e.g. you track a package, but you don't follow it)." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:InteractAction" .

schema:FundingScheme rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "FundingScheme" ;
    rdfs:comment "A FundingScheme combines organizational, project and policy aspects of grant-based funding that sets guidelines, principles and mechanisms to support other kinds of projects and activities. Funding is typically organized via Grant funding. Examples of funding schemes: Swiss Priority Programmes (SPPs); EU Framework 7 (FP7); Horizon 2020; the NIH-R01 Grant Program; Wellcome institutional strategic support fund. For large scale public sector funding, the management and administration of grant awards is often handled by other, dedicated, organizations - FundingAgencys such as ERC, REA, ..." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:GatedResidenceCommunity rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "GatedResidenceCommunity" ;
    rdfs:comment "Residence type: Gated community." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Residence" .

schema:GenderType rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "GenderType" ;
    rdfs:comment "An enumeration of genders." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Enumeration" .

schema:GeoCoordinates rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "GeoCoordinates" ;
    rdfs:comment "The geographic coordinates of a place or event." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:StructuredValue" .

schema:GovernmentOrganization rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "GovernmentOrganization" ;
    rdfs:comment "A governmental organization or agency." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:ImageObject rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "ImageObject" ;
    rdfs:comment "An image file." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MediaObject" .

schema:ImageObjectSnapshot rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "ImageObjectSnapshot" ;
    rdfs:comment "A specific and exact (byte-for-byte) version of an ImageObject. Two byte-for-byte identical files, for the purposes of this type, considered identical. If they have different embedded metadata (e.g. XMP, EXIF) the files will differ. Different external facts about the files, e.g. creator or dateCreated that aren't represented in their actual content, do not affect this notion of identity." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:ImageObject" .

schema:InfectiousDisease rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "InfectiousDisease" ;
    rdfs:comment "An infectious disease is a clinically evident human disease resulting from the presence of pathogenic microbial agents, like pathogenic viruses, pathogenic bacteria, fungi, protozoa, multicellular parasites, and prions. To be considered an infectious disease, such pathogens are known to be able to cause this disease." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalCondition" .

schema:InvestmentOrDeposit rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "InvestmentOrDeposit" ;
    rdfs:comment "A type of financial product that typically requires the client to transfer funds to a financial service in return for potential beneficial financial return." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:FinancialProduct" .

schema:Landform rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Landform" ;
    rdfs:comment "A landform or physical feature. Landform elements include mountains, plains, lakes, rivers, seascape and oceanic waterbody interface features such as bays, peninsulas, seas and so forth, including sub-aqueous terrain features such as submersed mountain ranges, volcanoes, and the great ocean basins." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Place" .

schema:LandmarksOrHistoricalBuildings rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "LandmarksOrHistoricalBuildings" ;
    rdfs:comment "An historical landmark or building." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Place" .

schema:LibrarySystem rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "LibrarySystem" ;
    rdfs:comment "A LibrarySystem is a collaborative system amongst several libraries." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:LifestyleModification rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "LifestyleModification" ;
    rdfs:comment "A process of care involving exercise, changes to diet, fitness routines, and other lifestyle changes aimed at improving a health condition." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:LoanOrCredit rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "LoanOrCredit" ;
    rdfs:comment "A financial product for the loaning of an amount of money, or line of credit, under agreed terms and charges." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:FinancialProduct" .

schema:LocalBusiness rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "LocalBusiness" ;
    rdfs:comment "A particular physical business or branch of an organization. Examples of LocalBusiness include a restaurant, a particular branch of a restaurant chain, a branch of a bank, a medical practice, a club, a bowling alley, etc." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization, schema:Place" .

schema:Male rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Male" ;
    rdfs:comment "The male gender." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Enumeração" ;
    myont:contextoExterno "tipo: schema:GenderType" .

schema:MedicalCause rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalCause" ;
    rdfs:comment "The causative agent(s) that are responsible for the pathophysiologic process that eventually results in a medical condition, symptom or sign. In this schema, unless otherwise specified this is meant to be the proximate cause of the medical condition, symptom or sign. The proximate cause is defined as the causative agent that most directly results in the medical condition, symptom or sign. For example, the HIV virus could be considered a cause of AIDS. Or in a diagnostic context, if a patient fell and sustained a hip fracture and two days later sustained a pulmonary embolism which eventuated in a cardiac arrest, the cause of the cardiac arrest (the proximate cause) would be the pulmonary embolism and not the fall. Medical causes can include cardiovascular, chemical, dermatologic, endocrine, environmental, gastroenterologic, genetic, hematologic, gynecologic, iatrogenic, infectious, musculoskeletal, neurologic, nutritional, obstetric, oncologic, otolaryngologic, pharmacologic, psychiatric, pulmonary, renal, rheumatologic, toxic, traumatic, or urologic causes; medical conditions can be causes as well." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:MedicalCondition rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalCondition" ;
    rdfs:comment "Any condition of the human body that affects the normal functioning of a person, whether physically or mentally. Includes diseases, injuries, disabilities, disorders, syndromes, etc." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:MedicalContraindication rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalContraindication" ;
    rdfs:comment "A condition or factor that serves as a reason to withhold a certain medical therapy. Contraindications can be absolute (there are no reasonable circumstances for undertaking a course of action) or relative (the patient is at higher risk of complications, but these risks may be outweighed by other considerations or mitigated by other measures)." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:MedicalDevice rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalDevice" ;
    rdfs:comment "Any object used in a medical capacity, such as to diagnose or treat a patient." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:MedicalEntity rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalEntity" ;
    rdfs:comment "The most generic type of entity related to health and the practice of medicine." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Thing" .

schema:MedicalGuideline rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalGuideline" ;
    rdfs:comment "Any recommendation made by a standard society (e.g. ACC/AHA) or consensus statement that denotes how to diagnose and treat a particular condition. Note: this type should be used to tag the actual guideline recommendation; if the guideline recommendation occurs in a larger scholarly article, use MedicalScholarlyArticle to tag the overall article, not this type. Note also: the organization making the recommendation should be captured in the recognizingAuthority base property of MedicalEntity." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:MedicalIndication rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalIndication" ;
    rdfs:comment "A condition or factor that indicates use of a medical therapy, including signs, symptoms, risk factors, anatomical states, etc." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:MedicalIntangible rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalIntangible" ;
    rdfs:comment "A utility class that serves as the umbrella for a number of 'intangible' things in the medical space." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:MedicalOrganization rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalOrganization" ;
    rdfs:comment "A medical organization (physical or not), such as hospital, institution or clinic." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:MedicalProcedure rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalProcedure" ;
    rdfs:comment "A process of care used in either a diagnostic, therapeutic, preventive or palliative capacity that relies on invasive (surgical), non-invasive, or other techniques." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:MedicalRiskEstimator rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalRiskEstimator" ;
    rdfs:comment "Any rule set or interactive tool for estimating the risk of developing a complication or condition." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:MedicalRiskFactor rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalRiskFactor" ;
    rdfs:comment "A risk factor is anything that increases a person's likelihood of developing or contracting a disease, medical condition, or complication." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:MedicalSignOrSymptom rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalSignOrSymptom" ;
    rdfs:comment "Any feature associated or not with a medical condition. In medicine a symptom is generally subjective while a sign is objective." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalCondition" .

schema:MedicalStudy rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalStudy" ;
    rdfs:comment "A medical study is an umbrella type covering all kinds of research studies relating to human medicine or health, including observational studies and interventional trials and registries, randomized, controlled or not. When the specific type of study is known, use one of the extensions of this type, such as MedicalTrial or MedicalObservationalStudy. Also, note that this type should be used to mark up data that describes the study itself; to tag an article that publishes the results of a study, use MedicalScholarlyArticle. Note: use the code property of MedicalEntity to store study IDs, e.g. clinicaltrials.gov ID." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:MedicalTest rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MedicalTest" ;
    rdfs:comment "Any medical test, typically performed for diagnostic purposes." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:Message rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Message" ;
    rdfs:comment "A single message from a sender to one or more organizations or people." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:CreativeWork" .

schema:MonetaryAmount rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MonetaryAmount" ;
    rdfs:comment "A monetary value or range. This type can be used to describe an amount of money such as $50 USD, or a range as in describing a bank account being suitable for a balance between £1,000 and £1,000,000 GBP, or the value of a salary, etc. It is recommended to use PriceSpecification Types to describe the price of an Offer, Invoice, etc." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:StructuredValue" .

schema:MortgageLoan rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "MortgageLoan" ;
    rdfs:comment "A loan in which property or real estate is used as collateral. (A loan securitized against some real estate.)" ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:LoanOrCredit" .

schema:NGO rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "NGO" ;
    rdfs:comment "Organization: Non-governmental Organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:NewsMediaOrganization rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "NewsMediaOrganization" ;
    rdfs:comment "A News/Media organization such as a newspaper or TV station." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:Occupation rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Occupation" ;
    rdfs:comment "A profession, may involve prolonged training and/or a formal qualification." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Intangible" .

schema:OnlineBusiness rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "OnlineBusiness" ;
    rdfs:comment "A particular online business, either standalone or the online part of a broader organization. Examples include an eCommerce site, an online travel booking site, an online learning site, an online logistics and shipping provider, an online (virtual) doctor, etc." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:Organization rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Organization" ;
    rdfs:comment "An organization such as a school, NGO, corporation, club, etc." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Thing" .

schema:Patient rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Patient" ;
    rdfs:comment "A patient is any person recipient of health care services." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalAudience, schema:Person" .

schema:PayAction rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "PayAction" ;
    rdfs:comment "An agent pays a price to a participant." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:TradeAction" .

schema:PaymentCard rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "PaymentCard" ;
    rdfs:comment "A payment method using a credit, debit, store or other card to associate the payment with an account." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:FinancialProduct, schema:PaymentMethod" .

schema:PaymentService rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "PaymentService" ;
    rdfs:comment "A Service to transfer funds from a person or organization to a beneficiary person or organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:FinancialProduct, schema:PaymentMethod" .

schema:PerformingGroup rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "PerformingGroup" ;
    rdfs:comment "A performance group, such as a band, an orchestra, or a circus." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:Person rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Person" ;
    rdfs:comment "A person (alive, dead, undead, or fictional)." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Thing" .

schema:Photograph rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Photograph" ;
    rdfs:comment "A photograph." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:CreativeWork" .

schema:Place rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Place" ;
    rdfs:comment "Entities that have a somewhat fixed, physical extension." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Thing" .

schema:PoliticalParty rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "PoliticalParty" ;
    rdfs:comment "Organization: Political Party." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:PostalAddress rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "PostalAddress" ;
    rdfs:comment "The mailing address." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:ContactPoint" .

schema:RepaymentSpecification rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "RepaymentSpecification" ;
    rdfs:comment "A structured value representing repayment." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:StructuredValue" .

schema:ResearchOrganization rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "ResearchOrganization" ;
    rdfs:comment "A Research Organization (e.g. scientific institute, research company)." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:Residence rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Residence" ;
    rdfs:comment "The place where a person lives." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Place" .

schema:SearchRescueOrganization rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "SearchRescueOrganization" ;
    rdfs:comment "A Search and Rescue organization of some kind." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:SocialMediaPosting rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "SocialMediaPosting" ;
    rdfs:comment "A post to a social media platform, including blog posts, tweets, Facebook posts, etc." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Article" .

schema:SportsOrganization rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "SportsOrganization" ;
    rdfs:comment "Represents the collection of all sports organizations, including sports teams, governing bodies, and sports associations." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:Substance rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "Substance" ;
    rdfs:comment "Any matter of defined composition that has discrete existence, whose origin may be biological, mineral or chemical." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:SuperficialAnatomy rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "SuperficialAnatomy" ;
    rdfs:comment "Anatomical features that can be observed by sight (without dissection), including the form and proportions of the human body as well as surface landmarks that correspond to deeper subcutaneous structures. Superficial anatomy plays an important role in sports medicine, phlebotomy, and other medical specialties as underlying anatomical structures can be identified through surface palpation. For example, during back surgery, superficial anatomy can be used to palpate and count vertebrae to find the site of incision. Or in phlebotomy, superficial anatomy can be used to locate an underlying vein; for example, the median cubital vein can be located by palpating the borders of the cubital fossa (such as the epicondyles of the humerus) and then looking for the superficial signs of the vein, such as size, prominence, ability to refill after depression, and feel of surrounding tissue support. As another example, in a subluxation (dislocation) of the glenohumeral joint, the bony structure becomes pronounced with the deltoid muscle failing to cover the glenohumeral joint allowing the edges of the scapula to be superficially visible. Here, the superficial anatomy is the visible edges of the scapula, implying the underlying dislocation of the joint (the related anatomical structure)." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:MedicalEntity" .

schema:TouristAttraction rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "TouristAttraction" ;
    rdfs:comment "A tourist attraction. In principle any Thing can be a TouristAttraction, from a Mountain and LandmarksOrHistoricalBuildings to a LocalBusiness. This Type can be used on its own to describe a general TouristAttraction, or be used as an additionalType to add tourist attraction properties to any other type. (See examples below)" ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Place" .

schema:TouristDestination rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "TouristDestination" ;
    rdfs:comment "A tourist destination. In principle any Place can be a TouristDestination from a City, Region or Country to an AmusementPark or Hotel. This Type can be used on its own to describe a general TouristDestination, or be used as an additionalType to add tourist relevant properties to any other Place. A TouristDestination is defined as a Place that contains, or is colocated with, one or more TouristAttractions, often linked by a similar theme or interest to a particular touristType. The UNWTO defines Destination (main destination of a tourism trip) as the place visited that is central to the decision to take the trip. (See examples below.)" ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Place" .

schema:WorkersUnion rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "WorkersUnion" ;
    rdfs:comment "A Workers Union (also known as a Labor Union, Labour Union, or Trade Union) is an organization that promotes the interests of its worker members by collectively bargaining with management, organizing, and political lobbying." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Classe" ;
    myont:contextoExterno "subClassOf: schema:Organization" .

schema:acceptedPaymentMethod rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "acceptedPaymentMethod" ;
    rdfs:comment "The payment method(s) that are accepted in general by an organization, or for some specific demand or offer." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Demand, schema:Offer, schema:Organization | rangeIncludes: schema:LoanOrCredit, schema:PaymentMethod, schema:Text" .

schema:accommodationFloorPlan rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "accommodationFloorPlan" ;
    rdfs:comment "A floorplan of some Accommodation." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Accommodation, schema:Residence | rangeIncludes: schema:FloorPlan" .

schema:accountMinimumInflow rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "accountMinimumInflow" ;
    rdfs:comment "A minimum amount that has to be paid in every month." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:BankAccount | rangeIncludes: schema:MonetaryAmount" .

schema:accountOverdraftLimit rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "accountOverdraftLimit" ;
    rdfs:comment "An overdraft is an extension of credit from a lending institution when an account reaches zero. An overdraft allows the individual to continue withdrawing money even if the account has no funds in it. Basically the bank allows people to borrow a set amount of money." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:BankAccount | rangeIncludes: schema:MonetaryAmount" .

schema:actionableFeedbackPolicy rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "actionableFeedbackPolicy" ;
    rdfs:comment "For a NewsMediaOrganization or other news-related Organization, a statement about public engagement activities (for news media, the newsroom’s), including involving the public - digitally or otherwise -- in coverage decisions, reporting and activities after publication." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:NewsMediaOrganization, schema:Organization | rangeIncludes: schema:CreativeWork, schema:URL | subPropertyOf: schema:publishingPrinciples" .

schema:additionalName rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "additionalName" ;
    rdfs:comment "An additional name for a Person, can be used for a middle name." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Text | subPropertyOf: schema:alternateName" .

schema:address rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "address" ;
    rdfs:comment "Physical address of the item." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeoCoordinates, schema:GeoShape, schema:Organization, schema:Person, schema:Place | rangeIncludes: schema:PostalAddress, schema:Text" .

schema:addressCountry rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "addressCountry" ;
    rdfs:comment "The country. Recommended to be in 2-letter ISO 3166-1 alpha-2 format, for example \"US\". For backward compatibility, a 3-letter ISO 3166-1 alpha-3 country code such as \"SGP\" or a full country name such as \"Singapore\" can also be used." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:DefinedRegion, schema:GeoCoordinates, schema:GeoShape, schema:PostalAddress | rangeIncludes: schema:Country, schema:Text" .

schema:addressLocality rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "addressLocality" ;
    rdfs:comment "The locality in which the street address is, and which is in the region. For example, Mountain View." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:PostalAddress | rangeIncludes: schema:Text" .

schema:addressRegion rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "addressRegion" ;
    rdfs:comment "The region in which the locality is, and which is in the country. For example, California or another appropriate first-level Administrative division such as the Province in Italy or Region in Germany." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:DefinedRegion, schema:PostalAddress | rangeIncludes: schema:AdministrativeArea, schema:Text" .

schema:affiliation rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "affiliation" ;
    rdfs:comment "An organization that this person is affiliated with. For example, a school/university, a club, or a team." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Organization | subPropertyOf: schema:memberOf" .

schema:agentInteractionStatistic rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "agentInteractionStatistic" ;
    rdfs:comment "The number of completed interactions for this entity, in a particular role (the 'agent'), in a particular action (indicated in the statistic), and in a particular context (i.e. interactionService)." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:InteractionCounter" .

schema:aggregateRating rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "aggregateRating" ;
    rdfs:comment "The overall rating, based on a collection of reviews or ratings, of the item." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Brand, schema:CreativeWork, schema:Event, schema:Offer, schema:Organization, schema:Place, schema:Product, schema:Service | rangeIncludes: schema:AggregateRating" .

schema:alumni rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "alumni" ;
    rdfs:comment "Alumni of an organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:EducationalOrganization, schema:Organization | rangeIncludes: schema:Person" .

schema:alumniOf rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "alumniOf" ;
    rdfs:comment "An organization that the person is an alumni of." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:EducationalOrganization, schema:Organization" .

schema:amenityFeature rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "amenityFeature" ;
    rdfs:comment "An amenity feature (e.g. a characteristic or service) of the Accommodation. This generic property does not make a statement about whether the feature is included in an offer for the main accommodation or available at extra costs." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Accommodation, schema:FloorPlan, schema:LodgingBusiness, schema:Place | rangeIncludes: schema:LocationFeatureSpecification" .

schema:amount rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "amount" ;
    rdfs:comment "The amount of money." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:DatedMoneySpecification, schema:InvestmentOrDeposit, schema:LoanOrCredit, schema:MonetaryGrant, schema:MoneyTransfer | rangeIncludes: schema:MonetaryAmount, schema:Number" .

schema:annualPercentageRate rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "annualPercentageRate" ;
    rdfs:comment "The annual rate that is charged for borrowing (or made by investing), expressed as a single percentage number that represents the actual yearly cost of funds over the term of a loan. This includes any fees or additional costs associated with the transaction." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:FinancialProduct | rangeIncludes: schema:Number, schema:QuantitativeValue" .

schema:areaServed rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "areaServed" ;
    rdfs:comment "The geographic area where a service or offered item is provided." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:ContactPoint, schema:DeliveryChargeSpecification, schema:Demand, schema:FinancialIncentive, schema:Offer, schema:Organization, schema:Service | rangeIncludes: schema:AdministrativeArea, schema:GeoShape, schema:Place, schema:Text" .

schema:associatedAnatomy rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "associatedAnatomy" ;
    rdfs:comment "The anatomy of the underlying organ system or structures associated with this entity." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition, schema:PhysicalActivity | rangeIncludes: schema:AnatomicalStructure, schema:AnatomicalSystem, schema:SuperficialAnatomy" .

schema:authorizedRepresentative rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "authorizedRepresentative" ;
    rdfs:comment "An organization or person officially appointed to act on behalf of the manufacturer in a specific region or context." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Product | rangeIncludes: schema:Organization, schema:Person" .

schema:award rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "award" ;
    rdfs:comment "An award won by or for this item." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:CreativeWork, schema:Organization, schema:Person, schema:Product, schema:Service | rangeIncludes: schema:Text" .

schema:awards rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "awards" ;
    rdfs:comment "Awards won by or for this item." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:CreativeWork, schema:Organization, schema:Person, schema:Product | rangeIncludes: schema:Text" .

schema:bankAccountType rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "bankAccountType" ;
    rdfs:comment "The type of a bank account." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:BankAccount | rangeIncludes: schema:Text, schema:URL" .

schema:baseSalary rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "baseSalary" ;
    rdfs:comment "The base salary of the job or of an employee in an EmployeeRole." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:EmployeeRole, schema:JobPosting | rangeIncludes: schema:MonetaryAmount, schema:Number, schema:PriceSpecification" .

schema:bccRecipient rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "bccRecipient" ;
    rdfs:comment "A sub property of recipient. The recipient blind copied on a message." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Message | rangeIncludes: schema:ContactPoint, schema:Organization, schema:Person | subPropertyOf: schema:recipient" .

schema:birthDate rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "birthDate" ;
    rdfs:comment "Date of birth." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Date" .

schema:birthPlace rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "birthPlace" ;
    rdfs:comment "The place where the person was born." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Place" .

schema:branchCode rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "branchCode" ;
    rdfs:comment "A short textual code (also called \"store code\") that uniquely identifies a place of business. The code is typically assigned by the parentOrganization and used in structured URLs.\\\\n\\\\nFor example, in the URL http://www.starbucks.co.uk/store-locator/etc/detail/3047 the code \"3047\" is a branchCode for a particular branch." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:Text" .

schema:brand rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "brand" ;
    rdfs:comment "The brand(s) associated with a product or service, or the brand(s) maintained by an organization or business person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person, schema:Product, schema:Service | rangeIncludes: schema:Brand, schema:Organization" .

schema:callSign rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "callSign" ;
    rdfs:comment "A callsign, as used in broadcasting and radio communications to identify people, radio and TV stations, or vehicles." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:BroadcastService, schema:Person, schema:Vehicle | rangeIncludes: schema:Text | subPropertyOf: schema:identifier" .

schema:caption rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "caption" ;
    rdfs:comment "The caption for this object. For downloadable machine formats (closed caption, subtitles etc.) use MediaObject and indicate the encodingFormat." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:AudioObject, schema:ImageObject, schema:VideoObject | rangeIncludes: schema:MediaObject, schema:Text" .

schema:cashBack rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "cashBack" ;
    rdfs:comment "A cardholder benefit that pays the cardholder a small percentage of their net expenditures." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:PaymentCard | rangeIncludes: schema:Boolean, schema:Number" .

schema:category rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "category" ;
    rdfs:comment "A category for the item. Greater signs or slashes can be used to informally indicate a category hierarchy." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:ActionAccessSpecification, schema:Guide, schema:Invoice, schema:Offer, schema:PhysicalActivity, schema:Product, schema:Recommendation, schema:Service, schema:SpecialAnnouncement | rangeIncludes: schema:CategoryCode, schema:PhysicalActivityCategory, schema:Text, schema:Thing, schema:URL" .

schema:cause rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "cause" ;
    rdfs:comment "The cause of a medical condition." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition | rangeIncludes: schema:MedicalCause" .

schema:ccRecipient rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "ccRecipient" ;
    rdfs:comment "A sub property of recipient. The recipient copied on a message." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Message | rangeIncludes: schema:ContactPoint, schema:Organization, schema:Person | subPropertyOf: schema:recipient" .

schema:children rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "children" ;
    rdfs:comment "A child of the person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Person" .

schema:code rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "code" ;
    rdfs:comment "A medical code for the entity, taken from a controlled vocabulary or ontology such as ICD-9, DiseasesDB, MeSH, SNOMED-CT, RxNorm, etc." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalEntity | rangeIncludes: schema:MedicalCode" .

schema:colleague rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "colleague" ;
    rdfs:comment "A colleague of the person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Person, schema:URL" .

schema:colleagues rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "colleagues" ;
    rdfs:comment "A colleague of the person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Person" .

schema:companyRegistration rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "companyRegistration" ;
    rdfs:comment "The official registration information of a business including the organization that issued it such as Company House or Chamber of Commerce in form of a Certification." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Certification" .

schema:competencyRequired rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "competencyRequired" ;
    rdfs:comment "Knowledge, skill, ability or personal attribute that must be demonstrated by a person or other entity in order to do something such as earn an Educational Occupational Credential or understand a LearningResource." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:EducationalOccupationalCredential, schema:LearningResource | rangeIncludes: schema:DefinedTerm, schema:Text, schema:URL" .

schema:contactPoint rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "contactPoint" ;
    rdfs:comment "A contact point for a person or organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:HealthInsurancePlan, schema:Organization, schema:Person | rangeIncludes: schema:ContactPoint" .

schema:contactPoints rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "contactPoints" ;
    rdfs:comment "A contact point for a person or organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:ContactPoint" .

schema:contactlessPayment rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "contactlessPayment" ;
    rdfs:comment "A secure method for consumers to purchase products or services via debit, credit or smartcards by using RFID or NFC technology." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:PaymentCard | rangeIncludes: schema:Boolean" .

schema:containedIn rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "containedIn" ;
    rdfs:comment "The basic containment relation between a place and one that contains it." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:Place" .

schema:containedInPlace rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "containedInPlace" ;
    rdfs:comment "The basic containment relation between a place and one that contains it." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:Place" .

schema:containsPlace rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "containsPlace" ;
    rdfs:comment "The basic containment relation between a place and another that it contains." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:Place" .

schema:correctionsPolicy rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "correctionsPolicy" ;
    rdfs:comment "For an Organization (e.g. NewsMediaOrganization), a statement describing (in news media, the newsroom’s) disclosure and correction policy for errors." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:NewsMediaOrganization, schema:Organization | rangeIncludes: schema:CreativeWork, schema:URL | subPropertyOf: schema:publishingPrinciples" .

schema:currency rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "currency" ;
    rdfs:comment "The currency in which the monetary amount is expressed.\\\\n\\\\nUse standard formats: ISO 4217 currency format, e.g. \"USD\"; Ticker symbol for cryptocurrencies, e.g. \"BTC\"; well known names for Local Exchange Trading Systems (LETS) and other currency types, e.g. \"Ithaca HOUR\"." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:DatedMoneySpecification, schema:ExchangeRateSpecification, schema:LoanOrCredit, schema:MonetaryAmount, schema:MonetaryAmountDistribution | rangeIncludes: schema:Text" .

schema:dateRead rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "dateRead" ;
    rdfs:comment "The date/time at which the message has been read by the recipient if a single recipient exists." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Message | rangeIncludes: schema:Date, schema:DateTime" .

schema:dateReceived rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "dateReceived" ;
    rdfs:comment "The date/time the message was received if a single recipient exists." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Message | rangeIncludes: schema:DateTime" .

schema:dateSent rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "dateSent" ;
    rdfs:comment "The date/time at which the message was sent." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Message | rangeIncludes: schema:DateTime" .

schema:deathDate rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "deathDate" ;
    rdfs:comment "Date of death." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Date" .

schema:deathPlace rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "deathPlace" ;
    rdfs:comment "The place where the person died." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Place" .

schema:department rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "department" ;
    rdfs:comment "A relationship between an organization and a department of that organization, also described as an organization (allowing different urls, logos, opening hours). For example: a store with a pharmacy, or a bakery with a cafe." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Organization" .

schema:differentialDiagnosis rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "differentialDiagnosis" ;
    rdfs:comment "One of a set of differential diagnoses for the condition. Specifically, a closely-related or competing diagnosis typically considered later in the cognitive process whereby this medical condition is distinguished from others most likely responsible for a similar collection of signs and symptoms to reach the most parsimonious diagnosis or diagnoses in a patient." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition | rangeIncludes: schema:DDxElement" .

schema:dissolutionDate rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "dissolutionDate" ;
    rdfs:comment "The date that this organization was dissolved." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Date" .

schema:diversityPolicy rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "diversityPolicy" ;
    rdfs:comment "Statement on diversity policy by an Organization e.g. a NewsMediaOrganization. For a NewsMediaOrganization, a statement describing the newsroom’s diversity policy on both staffing and sources, typically providing staffing data." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:NewsMediaOrganization, schema:Organization | rangeIncludes: schema:CreativeWork, schema:URL" .

schema:diversityStaffingReport rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "diversityStaffingReport" ;
    rdfs:comment "For an Organization (often but not necessarily a NewsMediaOrganization), a report on staffing diversity issues. In a news context this might be for example ASNE or RTDNA (US) reports, or self-reported." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:NewsMediaOrganization, schema:Organization | rangeIncludes: schema:Article, schema:URL | subPropertyOf: schema:publishingPrinciples" .

schema:downPayment rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "downPayment" ;
    rdfs:comment "a type of payment made in cash during the onset of the purchase of an expensive good/service. The payment typically represents only a percentage of the full purchase price." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:RepaymentSpecification | rangeIncludes: schema:MonetaryAmount, schema:Number" .

schema:drug rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "drug" ;
    rdfs:comment "Specifying a drug or medicine used in a medication procedure." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:DrugClass, schema:MedicalCondition, schema:Patient, schema:TherapeuticProcedure | rangeIncludes: schema:Drug" .

schema:duns rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "duns" ;
    rdfs:comment "The Dun & Bradstreet DUNS number for identifying an organization or business person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:Text | subPropertyOf: schema:identifier" .

schema:earlyPrepaymentPenalty rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "earlyPrepaymentPenalty" ;
    rdfs:comment "The amount to be paid as a penalty in the event of early payment of the loan." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:RepaymentSpecification | rangeIncludes: schema:MonetaryAmount" .

schema:educationRequirements rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "educationRequirements" ;
    rdfs:comment "Educational background needed for the position or Occupation." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:JobPosting, schema:Occupation | rangeIncludes: schema:EducationalOccupationalCredential, schema:Text" .

schema:educationalLevel rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "educationalLevel" ;
    rdfs:comment "The level in terms of progression through an educational or training context. Examples of educational levels include 'beginner', 'intermediate' or 'advanced', and formal sets of level indicators." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:CreativeWork, schema:EducationEvent, schema:EducationalOccupationalCredential, schema:LearningResource | rangeIncludes: schema:DefinedTerm, schema:Text, schema:URL" .

schema:elevation rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "elevation" ;
    rdfs:comment "The elevation of a location (WGS 84). Values may be of the form 'NUMBER UNIT\\\\_OF\\\\_MEASUREMENT' (e.g., '1,000 m', '3,200 ft') while numbers alone should be assumed to be a value in meters." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeoCoordinates, schema:GeoShape | rangeIncludes: schema:Number, schema:Text" .

schema:email rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "email" ;
    rdfs:comment "Email address." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:ContactPoint, schema:Organization, schema:Person | rangeIncludes: schema:Text" .

schema:embeddedTextCaption rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "embeddedTextCaption" ;
    rdfs:comment "Represents textual captioning from a MediaObject, e.g. text of a 'meme'." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:AudioObject, schema:ImageObject, schema:VideoObject | rangeIncludes: schema:Text | subPropertyOf: schema:caption" .

schema:employee rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "employee" ;
    rdfs:comment "Someone working for this organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Person" .

schema:employees rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "employees" ;
    rdfs:comment "People working for this organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Person" .

schema:employmentType rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "employmentType" ;
    rdfs:comment "Type of employment (e.g. full-time, part-time, contract, temporary, seasonal, internship)." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:JobPosting | rangeIncludes: schema:Text" .

schema:epidemiology rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "epidemiology" ;
    rdfs:comment "The characteristics of associated patients, such as age, gender, race etc." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition, schema:PhysicalActivity | rangeIncludes: schema:Text" .

schema:estimatedSalary rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "estimatedSalary" ;
    rdfs:comment "An estimated salary for a job posting or occupation, based on a variety of variables including, but not limited to industry, job title, and location. Estimated salaries are often computed by outside organizations rather than the hiring organization, who may not have committed to the estimated value." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:JobPosting, schema:Occupation | rangeIncludes: schema:MonetaryAmount, schema:MonetaryAmountDistribution, schema:Number" .

schema:ethicsPolicy rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "ethicsPolicy" ;
    rdfs:comment "Statement about ethics policy, e.g. of a NewsMediaOrganization regarding journalistic and publishing practices, or of a Restaurant, a page describing food source policies. In the case of a NewsMediaOrganization, an ethicsPolicy is typically a statement describing the personal, organizational, and corporate standards of behavior expected by the organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:NewsMediaOrganization, schema:Organization | rangeIncludes: schema:CreativeWork, schema:URL" .

schema:event rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "event" ;
    rdfs:comment "Upcoming or past event associated with this place, organization, or action." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:InformAction, schema:InviteAction, schema:JoinAction, schema:LeaveAction, schema:Organization, schema:Place, schema:PlayAction | rangeIncludes: schema:Event" .

schema:events rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "events" ;
    rdfs:comment "Upcoming or past events associated with this place or organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Place | rangeIncludes: schema:Event" .

schema:exifData rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "exifData" ;
    rdfs:comment "exif data for this object." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:ImageObject | rangeIncludes: schema:PropertyValue, schema:Text" .

schema:expectedPrognosis rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "expectedPrognosis" ;
    rdfs:comment "The likely outcome in either the short term or long term of the medical condition." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition | rangeIncludes: schema:Text" .

schema:experienceRequirements rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "experienceRequirements" ;
    rdfs:comment "Description of skills and experience needed for the position or Occupation." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:JobPosting, schema:Occupation | rangeIncludes: schema:OccupationalExperienceRequirements, schema:Text" .

schema:extendedAddress rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "extendedAddress" ;
    rdfs:comment "An address extension such as an apartment number, C/O or alternative name." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:PostalAddress | rangeIncludes: schema:Text" .

schema:familyName rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "familyName" ;
    rdfs:comment "Family name. In the U.S., the last name of a Person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Text" .

schema:faxNumber rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "faxNumber" ;
    rdfs:comment "The fax number." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:ContactPoint, schema:Organization, schema:Person, schema:Place | rangeIncludes: schema:Text" .

schema:feesAndCommissionsSpecification rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "feesAndCommissionsSpecification" ;
    rdfs:comment "Description of fees, commissions, and other terms applied either to a class of financial product, or by a financial service organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:FinancialProduct, schema:FinancialService | rangeIncludes: schema:Text, schema:URL" .

schema:floorLevel rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "floorLevel" ;
    rdfs:comment "The floor level for an Accommodation in a multi-storey building. Since counting systems vary internationally, the local system should be used where possible." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Accommodation, schema:LocalBusiness, schema:Residence | rangeIncludes: schema:Text" .

schema:floorLimit rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "floorLimit" ;
    rdfs:comment "A floor limit is the amount of money above which credit card transactions must be authorized." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:PaymentCard | rangeIncludes: schema:MonetaryAmount" .

schema:followee rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "followee" ;
    rdfs:comment "A sub property of object. The person or organization being followed." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:FollowAction | rangeIncludes: schema:Organization, schema:Person | subPropertyOf: schema:object" .

schema:follows rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "follows" ;
    rdfs:comment "The most generic uni-directional social relation." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Person" .

schema:founder rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "founder" ;
    rdfs:comment "A person or organization who founded this organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Organization, schema:Person" .

schema:founders rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "founders" ;
    rdfs:comment "A person who founded this organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Person" .

schema:foundingDate rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "foundingDate" ;
    rdfs:comment "The date that this organization was founded." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Date" .

schema:foundingLocation rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "foundingLocation" ;
    rdfs:comment "The place where the Organization was founded." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Place" .

schema:funder rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "funder" ;
    rdfs:comment "A person or organization that supports (sponsors) something through some kind of financial contribution." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:CreativeWork, schema:Event, schema:Grant, schema:MonetaryGrant, schema:Organization, schema:Person | rangeIncludes: schema:Organization, schema:Person | subPropertyOf: schema:sponsor" .

schema:funding rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "funding" ;
    rdfs:comment "A Grant that directly or indirectly provide funding or sponsorship for this item. See also ownershipFundingInfo." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:BioChemEntity, schema:CreativeWork, schema:Event, schema:MedicalEntity, schema:Organization, schema:Person, schema:Product | rangeIncludes: schema:Grant" .

schema:gender rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "gender" ;
    rdfs:comment "Gender of something, typically a Person, but possibly also fictional characters, animals, etc. While https://schema.org/Male and https://schema.org/Female may be used, text strings are also acceptable for people who are not a binary gender. The gender property can also be used in an extended sense to cover e.g. the gender of sports teams. As with the gender of individuals, we do not try to enumerate all possibilities. A mixed-gender SportsTeam can be indicated with a text value of \"Mixed\"." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person, schema:SportsTeam | rangeIncludes: schema:GenderType, schema:Text" .

schema:geo rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "geo" ;
    rdfs:comment "The geo coordinates of the place." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:GeoCoordinates, schema:GeoShape" .

schema:geoContains rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "geoContains" ;
    rdfs:comment "Represents a relationship between two geometries (or the places they represent), relating a containing geometry to a contained geometry. \"a contains b iff no points of b lie in the exterior of a, and at least one point of the interior of b lies in the interior of a\". As defined in DE-9IM." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeospatialGeometry, schema:Place | rangeIncludes: schema:GeospatialGeometry, schema:Place" .

schema:geoCoveredBy rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "geoCoveredBy" ;
    rdfs:comment "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that covers it. As defined in DE-9IM." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeospatialGeometry, schema:Place | rangeIncludes: schema:GeospatialGeometry, schema:Place" .

schema:geoCovers rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "geoCovers" ;
    rdfs:comment "Represents a relationship between two geometries (or the places they represent), relating a covering geometry to a covered geometry. \"Every point of b is a point of (the interior or boundary of) a\". As defined in DE-9IM." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeospatialGeometry, schema:Place | rangeIncludes: schema:GeospatialGeometry, schema:Place" .

schema:geoCrosses rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "geoCrosses" ;
    rdfs:comment "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that crosses it: \"a crosses b: they have some but not all interior points in common, and the dimension of the intersection is less than that of at least one of them\". As defined in DE-9IM." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeospatialGeometry, schema:Place | rangeIncludes: schema:GeospatialGeometry, schema:Place" .

schema:geoDisjoint rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "geoDisjoint" ;
    rdfs:comment "Represents spatial relations in which two geometries (or the places they represent) are topologically disjoint: \"they have no point in common. They form a set of disconnected geometries.\" (A symmetric relationship, as defined in DE-9IM.)" ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeospatialGeometry, schema:Place | rangeIncludes: schema:GeospatialGeometry, schema:Place" .

schema:geoEquals rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "geoEquals" ;
    rdfs:comment "Represents spatial relations in which two geometries (or the places they represent) are topologically equal, as defined in DE-9IM. \"Two geometries are topologically equal if their interiors intersect and no part of the interior or boundary of one geometry intersects the exterior of the other\" (a symmetric relationship)." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeospatialGeometry, schema:Place | rangeIncludes: schema:GeospatialGeometry, schema:Place" .

schema:geoIntersects rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "geoIntersects" ;
    rdfs:comment "Represents spatial relations in which two geometries (or the places they represent) have at least one point in common. As defined in DE-9IM." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeospatialGeometry, schema:Place | rangeIncludes: schema:GeospatialGeometry, schema:Place" .

schema:geoOverlaps rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "geoOverlaps" ;
    rdfs:comment "Represents a relationship between two geometries (or the places they represent), relating a geometry to another that geospatially overlaps it, i.e. they have some but not all points in common. As defined in DE-9IM." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeospatialGeometry, schema:Place | rangeIncludes: schema:GeospatialGeometry, schema:Place" .

schema:geoTouches rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "geoTouches" ;
    rdfs:comment "Represents spatial relations in which two geometries (or the places they represent) touch: \"they have at least one boundary point in common, but no interior points.\" (A symmetric relationship, as defined in DE-9IM.)" ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeospatialGeometry, schema:Place | rangeIncludes: schema:GeospatialGeometry, schema:Place" .

schema:geoWithin rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "geoWithin" ;
    rdfs:comment "Represents a relationship between two geometries (or the places they represent), relating a geometry to one that contains it, i.e. it is inside (i.e. within) its interior. As defined in DE-9IM." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeospatialGeometry, schema:Place | rangeIncludes: schema:GeospatialGeometry, schema:Place" .

schema:givenName rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "givenName" ;
    rdfs:comment "Given name. In the U.S., the first name of a Person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Text" .

schema:globalLocationNumber rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "globalLocationNumber" ;
    rdfs:comment "The Global Location Number (GLN, sometimes also referred to as International Location Number or ILN) of the respective organization, person, or place. The GLN is a 13-digit number used to identify parties and physical locations." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person, schema:Place | rangeIncludes: schema:Text | subPropertyOf: schema:identifier" .

schema:gracePeriod rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "gracePeriod" ;
    rdfs:comment "The period of time after any due date that the borrower has to fulfil its obligations before a default (failure to pay) is deemed to have occurred." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:LoanOrCredit | rangeIncludes: schema:Duration" .

schema:guideline rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "guideline" ;
    rdfs:comment "A medical guideline related to this entity." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalEntity | rangeIncludes: schema:MedicalGuideline" .

schema:hasCertification rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "hasCertification" ;
    rdfs:comment "Certification information about a product, organization, service, place, or person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person, schema:Place, schema:Product, schema:Service | rangeIncludes: schema:Certification" .

schema:hasCredential rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "hasCredential" ;
    rdfs:comment "A credential awarded to the Person or Organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:Credential" .

schema:hasDriveThroughService rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "hasDriveThroughService" ;
    rdfs:comment "Indicates whether some facility (e.g. FoodEstablishment, CovidTestingFacility) offers a service that can be used by driving through in a car. In the case of CovidTestingFacility such facilities could potentially help with social distancing from other potentially-infected users." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:Boolean" .

schema:hasGS1DigitalLink rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "hasGS1DigitalLink" ;
    rdfs:comment "The <a href=\"https://www.gs1.org/standards/gs1-digital-link\">GS1 digital link</a> associated with the object. This URL should conform to the particular requirements of digital links. The link should only contain the Application Identifiers (AIs) that are relevant for the entity being annotated, for instance a Product or an Organization, and for the correct granularity. In particular, for products:<ul><li>A Digital Link that contains a serial number (AI <code>21</code>) should only be present on instances of IndividualProduct</li><li>A Digital Link that contains a lot number (AI <code>10</code>) should be annotated as SomeProducts if only products from that lot are sold, or IndividualProduct if there is only a specific product.</li><li>A Digital Link that contains a global model number (AI <code>8013</code>) should be attached to a Product or a ProductModel.</li></ul> Other item types should be adapted similarly." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Offer, schema:Organization, schema:Place, schema:Product | rangeIncludes: schema:URL | subPropertyOf: schema:identifier" .

schema:hasMap rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "hasMap" ;
    rdfs:comment "A URL to a map of the place." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:Map, schema:URL" .

schema:hasMemberProgram rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "hasMemberProgram" ;
    rdfs:comment "MemberProgram offered by an Organization, for example an eCommerce merchant or an airline." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:MemberProgram" .

schema:hasMerchantReturnPolicy rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "hasMerchantReturnPolicy" ;
    rdfs:comment "Specifies a MerchantReturnPolicy that may be applicable." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Offer, schema:Organization, schema:Product | rangeIncludes: schema:MerchantReturnPolicy" .

schema:hasOccupation rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "hasOccupation" ;
    rdfs:comment "The Person's occupation. For past professions, use Role for expressing dates." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Occupation" .

schema:hasOfferCatalog rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "hasOfferCatalog" ;
    rdfs:comment "Indicates an OfferCatalog listing for this Organization, Person, or Service." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person, schema:Service | rangeIncludes: schema:OfferCatalog" .

schema:hasPOS rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "hasPOS" ;
    rdfs:comment "Points-of-Sales operated by the organization or person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:Place" .

schema:hasProductReturnPolicy rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "hasProductReturnPolicy" ;
    rdfs:comment "Indicates a ProductReturnPolicy that may be applicable." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Product | rangeIncludes: schema:ProductReturnPolicy" .

schema:hasShippingService rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "hasShippingService" ;
    rdfs:comment "Specification of a shipping service offered by the organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:OfferShippingDetails, schema:Organization | rangeIncludes: schema:ShippingService" .

schema:height rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "height" ;
    rdfs:comment "The height of the item." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MediaObject, schema:OfferShippingDetails, schema:Person, schema:Product, schema:ShippingConditions, schema:VisualArtwork | rangeIncludes: schema:Distance, schema:QuantitativeValue" .

schema:homeLocation rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "homeLocation" ;
    rdfs:comment "A contact location for a person's residence." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:ContactPoint, schema:Place | subPropertyOf: schema:location" .

schema:honorificPrefix rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "honorificPrefix" ;
    rdfs:comment "An honorific prefix preceding a Person's name such as Dr/Mrs/Mr." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Text" .

schema:honorificSuffix rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "honorificSuffix" ;
    rdfs:comment "An honorific suffix following a Person's name such as M.D./PhD/MSCSW." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Text" .

schema:interactionStatistic rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "interactionStatistic" ;
    rdfs:comment "The number of interactions for the CreativeWork using the WebSite or SoftwareApplication. The most specific child type of InteractionCounter should be used." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:CreativeWork, schema:Organization, schema:Person | rangeIncludes: schema:InteractionCounter" .

schema:interestRate rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "interestRate" ;
    rdfs:comment "The interest rate, charged or paid, applicable to the financial product. Note: This is different from the calculated annualPercentageRate." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:FinancialProduct | rangeIncludes: schema:Number, schema:QuantitativeValue" .

schema:isAccessibleForFree rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "isAccessibleForFree" ;
    rdfs:comment "A flag to signal that the item, event, or place is accessible for free." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:CreativeWork, schema:Event, schema:Place | rangeIncludes: schema:Boolean" .

schema:isicV4 rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "isicV4" ;
    rdfs:comment "The International Standard of Industrial Classification of All Economic Activities (ISIC), Revision 4 code for a particular organization, business person, or place." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person, schema:Place | rangeIncludes: schema:Text" .

schema:iso6523Code rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "iso6523Code" ;
    rdfs:comment "An organization identifier as defined in ISO 6523(-1). The identifier should be in the `XXXX:YYYYYY:ZZZ` or `XXXX:YYYYYY`format. Where `XXXX` is a 4 digit _ICD_ (International Code Designator), `YYYYYY` is an _OID_ (Organization Identifier) with all formatting characters (dots, dashes, spaces) removed with a maximal length of 35 characters, and `ZZZ` is an optional OPI (Organization Part Identifier) with a maximum length of 35 characters. The various components (ICD, OID, OPI) are joined with a colon character (ASCII `0x3a`). Note that many existing organization identifiers defined as attributes like leiCode (`0199`), duns (`0060`) or GLN (`0088`) can be expressed using ISO-6523. If possible, ISO-6523 codes should be preferred to populating vatID or taxID, as ISO identifiers are less ambiguous." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Text" .

schema:jobTitle rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "jobTitle" ;
    rdfs:comment "The job title of the person (for example, Financial Manager)." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:DefinedTerm, schema:Text" .

schema:keywords rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "keywords" ;
    rdfs:comment "Keywords or tags used to describe some item. Multiple textual entries in a keywords list are typically delimited by commas, or by repeating the property." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:CreativeWork, schema:Event, schema:Organization, schema:Place, schema:Product | rangeIncludes: schema:DefinedTerm, schema:Text, schema:URL" .

schema:knows rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "knows" ;
    rdfs:comment "The most generic bi-directional social/work relation." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Person" .

schema:knowsAbout rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "knowsAbout" ;
    rdfs:comment "Of a Person, and less typically of an Organization, to indicate a topic that is known about - suggesting possible expertise but not implying it. We do not distinguish skill levels here, or relate this to educational content, events, objectives or JobPosting descriptions." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:Text, schema:Thing, schema:URL" .

schema:knowsLanguage rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "knowsLanguage" ;
    rdfs:comment "Of a Person, and less typically of an Organization, to indicate a known language. We do not distinguish skill levels or reading/writing/speaking/signing here. Use language codes from the IETF BCP 47 standard." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:Language, schema:Text" .

schema:latitude rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "latitude" ;
    rdfs:comment "The latitude of a location. For example ```37.42242``` (WGS 84)." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeoCoordinates, schema:Place | rangeIncludes: schema:Number, schema:Text" .

schema:legalAddress rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "legalAddress" ;
    rdfs:comment "The legal address of an organization which acts as the officially registered address used for legal and tax purposes. The legal address can be different from the place of operations of a business and other addresses can be part of an organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:PostalAddress" .

schema:legalName rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "legalName" ;
    rdfs:comment "The official name of the organization, e.g. the registered company name." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Text" .

schema:legalRepresentative rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "legalRepresentative" ;
    rdfs:comment "One or multiple persons who represent this organization legally such as CEO or sole administrator." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Person" .

schema:legalStatus rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "legalStatus" ;
    rdfs:comment "The drug or supplement's legal status, including any controlled substance schedules that apply." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:DietarySupplement, schema:Drug, schema:MedicalEntity | rangeIncludes: schema:DrugLegalStatus, schema:MedicalEnumeration, schema:Text" .

schema:leiCode rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "leiCode" ;
    rdfs:comment "An organization identifier that uniquely identifies a legal entity as defined in ISO 17442." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Text | subPropertyOf: schema:identifier" .

schema:lifeEvent rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "lifeEvent" ;
    rdfs:comment "A life event like baptism, communions, Bar Mitzvahs, Aqiqah, Namakarana, Miyamairi, burial, ...." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Event" .

schema:loanPaymentAmount rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "loanPaymentAmount" ;
    rdfs:comment "The amount of money to pay in a single payment." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:RepaymentSpecification | rangeIncludes: schema:MonetaryAmount" .

schema:loanPaymentFrequency rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "loanPaymentFrequency" ;
    rdfs:comment "Frequency of payments due, i.e. number of months between payments. This is defined as a frequency, i.e. the reciprocal of a period of time." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:RepaymentSpecification | rangeIncludes: schema:Number" .

schema:loanRepaymentForm rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "loanRepaymentForm" ;
    rdfs:comment "A form of paying back money previously borrowed from a lender. Repayment usually takes the form of periodic payments that normally include part principal plus interest in each payment." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:LoanOrCredit | rangeIncludes: schema:RepaymentSpecification" .

schema:loanTerm rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "loanTerm" ;
    rdfs:comment "The duration of the loan or credit agreement." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:LoanOrCredit | rangeIncludes: schema:QuantitativeValue | subPropertyOf: schema:duration" .

schema:loanType rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "loanType" ;
    rdfs:comment "The type of a loan or credit." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:LoanOrCredit | rangeIncludes: schema:Text, schema:URL" .

schema:location rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "location" ;
    rdfs:comment "The location of, for example, where an event is happening, where an organization is located, or where an action takes place." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Action, schema:Event, schema:InteractionCounter, schema:Organization | rangeIncludes: schema:Place, schema:PostalAddress, schema:Text, schema:VirtualLocation" .

schema:logo rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "logo" ;
    rdfs:comment "An associated logo." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Brand, schema:Certification, schema:Organization, schema:Place, schema:Product, schema:Service | rangeIncludes: schema:ImageObject, schema:URL | subPropertyOf: schema:image" .

schema:longitude rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "longitude" ;
    rdfs:comment "The longitude of a location. For example ```-122.08585``` (WGS 84)." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:GeoCoordinates, schema:Place | rangeIncludes: schema:Number, schema:Text" .

schema:makesOffer rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "makesOffer" ;
    rdfs:comment "A pointer to products or services offered by the organization or person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:Offer" .

schema:map rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "map" ;
    rdfs:comment "A URL to a map of the place." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:URL" .

schema:maps rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "maps" ;
    rdfs:comment "A URL to a map of the place." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:URL" .

schema:maxValue rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "maxValue" ;
    rdfs:comment "The upper value of some characteristic or property." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MonetaryAmount, schema:PropertyValue, schema:PropertyValueSpecification, schema:QuantitativeValue | rangeIncludes: schema:Number" .

schema:maximumAttendeeCapacity rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "maximumAttendeeCapacity" ;
    rdfs:comment "The total number of individuals that may attend an event or venue." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Event, schema:Place | rangeIncludes: schema:Integer" .

schema:medicineSystem rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "medicineSystem" ;
    rdfs:comment "The system of medicine that includes this MedicalEntity, for example 'evidence-based', 'homeopathic', 'chiropractic', etc." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalEntity | rangeIncludes: schema:MedicineSystem" .

schema:member rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "member" ;
    rdfs:comment "A member of an Organization or a ProgramMembership. Organizations can be members of organizations; ProgramMembership is typically for individuals." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:ProgramMembership | rangeIncludes: schema:Organization, schema:Person" .

schema:memberOf rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "memberOf" ;
    rdfs:comment "An Organization (or ProgramMembership) to which this Person or Organization belongs." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:MemberProgramTier, schema:Organization, schema:ProgramMembership" .

schema:members rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "members" ;
    rdfs:comment "A member of this organization." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:ProgramMembership | rangeIncludes: schema:Organization, schema:Person" .

schema:messageAttachment rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "messageAttachment" ;
    rdfs:comment "A CreativeWork attached to the message." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Message | rangeIncludes: schema:CreativeWork" .

schema:minValue rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "minValue" ;
    rdfs:comment "The lower value of some characteristic or property." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MonetaryAmount, schema:PropertyValue, schema:PropertyValueSpecification, schema:QuantitativeValue | rangeIncludes: schema:Number" .

schema:monthlyMinimumRepaymentAmount rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "monthlyMinimumRepaymentAmount" ;
    rdfs:comment "The minimum payment is the lowest amount of money that one is required to pay on a credit card statement each month." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:PaymentCard | rangeIncludes: schema:MonetaryAmount, schema:Number" .

schema:monthsOfExperience rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "monthsOfExperience" ;
    rdfs:comment "Indicates the minimal number of months of experience required for a position." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:OccupationalExperienceRequirements | rangeIncludes: schema:Number" .

schema:naics rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "naics" ;
    rdfs:comment "The North American Industry Classification System (NAICS) code for a particular organization or business person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:Text" .

schema:nationality rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "nationality" ;
    rdfs:comment "Nationality of the person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Country" .

schema:naturalProgression rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "naturalProgression" ;
    rdfs:comment "The expected progression of the condition if it is not treated and allowed to progress naturally." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition | rangeIncludes: schema:Text" .

schema:netWorth rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "netWorth" ;
    rdfs:comment "The total financial value of the person as calculated by subtracting the total value of liabilities from the total value of assets." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:MonetaryAmount, schema:PriceSpecification" .

schema:nonprofitStatus rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "nonprofitStatus" ;
    rdfs:comment "nonprofitStatus indicates the legal status of a non-profit organization in its primary place of business." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:NonprofitType" .

schema:numberOfEmployees rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "numberOfEmployees" ;
    rdfs:comment "The number of employees in an organization, e.g. business." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:BusinessAudience, schema:Organization | rangeIncludes: schema:QuantitativeValue" .

schema:numberOfLoanPayments rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "numberOfLoanPayments" ;
    rdfs:comment "The number of payments contractually required at origination to repay the loan. For monthly paying loans this is the number of months from the contractual first payment date to the maturity date." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:RepaymentSpecification | rangeIncludes: schema:Number" .

schema:occupationLocation rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "occupationLocation" ;
    rdfs:comment "The region/country for which this occupational description is appropriate. Note that educational requirements and qualifications can vary between jurisdictions." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Occupation | rangeIncludes: schema:AdministrativeArea" .

schema:openingHoursSpecification rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "openingHoursSpecification" ;
    rdfs:comment "The opening hours of a certain place." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:OpeningHoursSpecification" .

schema:ownershipFundingInfo rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "ownershipFundingInfo" ;
    rdfs:comment "For an Organization (often but not necessarily a NewsMediaOrganization), a description of organizational ownership structure; funding and grants. In a news/media setting, this is with particular reference to editorial independence. Note that the funder is also available and can be used to make basic funder information machine-readable." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:NewsMediaOrganization, schema:Organization | rangeIncludes: schema:AboutPage, schema:CreativeWork, schema:Text, schema:URL | subPropertyOf: schema:publishingPrinciples" .

schema:owns rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "owns" ;
    rdfs:comment "Things owned by the organization or person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:Thing" .

schema:parent rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "parent" ;
    rdfs:comment "A parent of this person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Person" .

schema:parentOrganization rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "parentOrganization" ;
    rdfs:comment "The larger organization that this organization is a subOrganization of, if any." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Organization" .

schema:parents rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "parents" ;
    rdfs:comment "A parents of the person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Person" .

schema:pathophysiology rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "pathophysiology" ;
    rdfs:comment "Changes in the normal mechanical, physical, and biochemical functions that are associated with this activity or condition." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition, schema:PhysicalActivity | rangeIncludes: schema:Text" .

schema:performerIn rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "performerIn" ;
    rdfs:comment "Event that this person is a performer or participant in." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Event" .

schema:photo rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "photo" ;
    rdfs:comment "A photograph of this place." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:ImageObject, schema:Photograph | subPropertyOf: schema:image" .

schema:photos rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "photos" ;
    rdfs:comment "Photographs of this place." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:ImageObject, schema:Photograph" .

schema:possibleComplication rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "possibleComplication" ;
    rdfs:comment "A possible unexpected and unfavorable evolution of a medical condition. Complications may include worsening of the signs or symptoms of the disease, extension of the condition to other organ systems, etc." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition | rangeIncludes: schema:Text" .

schema:possibleTreatment rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "possibleTreatment" ;
    rdfs:comment "A possible treatment to address this condition, sign or symptom." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition, schema:MedicalSignOrSymptom | rangeIncludes: schema:Drug, schema:DrugClass, schema:LifestyleModification, schema:MedicalTherapy" .

schema:postOfficeBoxNumber rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "postOfficeBoxNumber" ;
    rdfs:comment "The post office box number for PO box addresses." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:PostalAddress | rangeIncludes: schema:Text" .

schema:postalCode rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "postalCode" ;
    rdfs:comment "The postal code. For example, 94043." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:DefinedRegion, schema:GeoCoordinates, schema:GeoShape, schema:PostalAddress | rangeIncludes: schema:Text" .

schema:primaryPrevention rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "primaryPrevention" ;
    rdfs:comment "A preventative therapy used to prevent an initial occurrence of the medical condition, such as vaccination." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition | rangeIncludes: schema:MedicalTherapy" .

schema:publicAccess rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "publicAccess" ;
    rdfs:comment "A flag to signal that the Place is open to public visitors. If this property is omitted there is no assumed default boolean value." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:Boolean" .

schema:qualifications rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "qualifications" ;
    rdfs:comment "Specific qualifications required for this role or Occupation." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:JobPosting, schema:Occupation | rangeIncludes: schema:Credential, schema:Text" .

schema:recipient rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "recipient" ;
    rdfs:comment "A sub property of participant. The participant who is at the receiving end of the action." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:AuthorizeAction, schema:CommunicateAction, schema:DonateAction, schema:GiveAction, schema:Message, schema:PayAction, schema:ReturnAction, schema:SendAction, schema:TipAction | rangeIncludes: schema:Audience, schema:ContactPoint, schema:Organization, schema:Person | subPropertyOf: schema:participant" .

schema:recognizingAuthority rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "recognizingAuthority" ;
    rdfs:comment "If applicable, the organization that officially recognizes this entity as part of its endorsed system of medicine." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalEntity | rangeIncludes: schema:Organization" .

schema:recourseLoan rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "recourseLoan" ;
    rdfs:comment "The only way you get the money back in the event of default is the security. Recourse is where you still have the opportunity to go back to the borrower for the rest of the money." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:LoanOrCredit | rangeIncludes: schema:Boolean" .

schema:relatedTo rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "relatedTo" ;
    rdfs:comment "The most generic familial relation." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Person" .

schema:relevantSpecialty rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "relevantSpecialty" ;
    rdfs:comment "If applicable, a medical specialty in which this entity is relevant." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalEntity | rangeIncludes: schema:MedicalSpecialty" .

schema:renegotiableLoan rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "renegotiableLoan" ;
    rdfs:comment "Whether the terms for payment of interest can be renegotiated during the life of the loan." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:LoanOrCredit | rangeIncludes: schema:Boolean" .

schema:representativeOfPage rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "representativeOfPage" ;
    rdfs:comment "Indicates whether this image is representative of the content of the page." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:ImageObject | rangeIncludes: schema:Boolean" .

schema:requiredCollateral rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "requiredCollateral" ;
    rdfs:comment "Assets required to secure loan or credit repayments. It may take form of third party pledge, goods, financial instruments (cash, securities, etc.)" ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:LoanOrCredit | rangeIncludes: schema:Text, schema:Thing" .

schema:responsibilities rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "responsibilities" ;
    rdfs:comment "Responsibilities associated with this role or Occupation." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:JobPosting, schema:Occupation | rangeIncludes: schema:Text" .

schema:review rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "review" ;
    rdfs:comment "A review of the item." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Brand, schema:CreativeWork, schema:Event, schema:Offer, schema:Organization, schema:Place, schema:Product, schema:Service | rangeIncludes: schema:Review" .

schema:reviews rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "reviews" ;
    rdfs:comment "Review of the item." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:CreativeWork, schema:Offer, schema:Organization, schema:Place, schema:Product | rangeIncludes: schema:Review" .

schema:riskFactor rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "riskFactor" ;
    rdfs:comment "A modifiable or non-modifiable factor that increases the risk of a patient contracting this condition, e.g. age, coexisting condition." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition | rangeIncludes: schema:MedicalRiskFactor" .

schema:salaryCurrency rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "salaryCurrency" ;
    rdfs:comment "The currency (coded using ISO 4217) used for the main salary information in this job posting or for this employee." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:EmployeeRole, schema:JobPosting | rangeIncludes: schema:Text" .

schema:secondaryPrevention rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "secondaryPrevention" ;
    rdfs:comment "A preventative therapy used to prevent reoccurrence of the medical condition after an initial episode of the condition." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition | rangeIncludes: schema:Drug, schema:DrugClass, schema:LifestyleModification, schema:MedicalTherapy" .

schema:seeks rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "seeks" ;
    rdfs:comment "A pointer to products or services sought by the organization or person (demand)." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:Demand" .

schema:seller rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "seller" ;
    rdfs:comment "An entity which offers (sells / leases / lends / loans) the services / goods. A seller may also be a provider." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:BuyAction, schema:Demand, schema:Flight, schema:Offer, schema:Order | rangeIncludes: schema:Organization, schema:Person | subPropertyOf: schema:participant" .

schema:sender rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "sender" ;
    rdfs:comment "A sub property of participant. The participant who is at the sending end of the action." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Message, schema:ReceiveAction | rangeIncludes: schema:Audience, schema:Organization, schema:Person | subPropertyOf: schema:participant" .

schema:serviceArea rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "serviceArea" ;
    rdfs:comment "The geographic area where the service is provided." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:ContactPoint, schema:Organization, schema:Service | rangeIncludes: schema:AdministrativeArea, schema:GeoShape, schema:Place" .

schema:sharedContent rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "sharedContent" ;
    rdfs:comment "A CreativeWork such as an image, video, or audio clip shared as part of this posting." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Comment, schema:SocialMediaPosting | rangeIncludes: schema:CreativeWork" .

schema:sibling rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "sibling" ;
    rdfs:comment "A sibling of the person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Person" .

schema:siblings rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "siblings" ;
    rdfs:comment "A sibling of the person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Person" .

schema:signOrSymptom rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "signOrSymptom" ;
    rdfs:comment "A sign or symptom of this condition. Signs are objective or physically observable manifestations of the medical condition while symptoms are the subjective experience of the medical condition." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition | rangeIncludes: schema:MedicalSignOrSymptom" .

schema:skills rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "skills" ;
    rdfs:comment "A statement of knowledge, skill, ability, task or any other assertion expressing a competency that is either claimed by a person, an organization or desired or required to fulfill a role or to work in an occupation." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:JobPosting, schema:Occupation, schema:Organization, schema:Person | rangeIncludes: schema:DefinedTerm, schema:Text" .

schema:slogan rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "slogan" ;
    rdfs:comment "A slogan or motto associated with the item." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Brand, schema:Organization, schema:Place, schema:Product, schema:Service | rangeIncludes: schema:Text" .

schema:smokingAllowed rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "smokingAllowed" ;
    rdfs:comment "Indicates whether it is allowed to smoke in the place, e.g. in the restaurant, hotel or hotel room." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:Boolean" .

schema:specialOpeningHoursSpecification rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "specialOpeningHoursSpecification" ;
    rdfs:comment "The special opening hours of a certain place.\\\\n\\\\nUse this to explicitly override general opening hours brought in scope by openingHoursSpecification or openingHours." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Place | rangeIncludes: schema:OpeningHoursSpecification" .

schema:sponsor rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "sponsor" ;
    rdfs:comment "A person or organization that supports a thing through a pledge, promise, or financial contribution. E.g. a sponsor of a Medical Study or a corporate sponsor of an event." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:CreativeWork, schema:Event, schema:Grant, schema:MedicalStudy, schema:Organization, schema:Person | rangeIncludes: schema:Organization, schema:Person" .

schema:spouse rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "spouse" ;
    rdfs:comment "The person's spouse." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Person" .

schema:stage rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "stage" ;
    rdfs:comment "The stage of the condition, if applicable." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition | rangeIncludes: schema:MedicalConditionStage" .

schema:status rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "status" ;
    rdfs:comment "The status of the study (enumerated)." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition, schema:MedicalProcedure, schema:MedicalStudy | rangeIncludes: schema:EventStatusType, schema:MedicalStudyStatus, schema:Text" .

schema:streetAddress rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "streetAddress" ;
    rdfs:comment "The street address. For example, 1600 Amphitheatre Pkwy." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:PostalAddress | rangeIncludes: schema:Text" .

schema:study rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "study" ;
    rdfs:comment "A medical study or trial related to this entity." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalEntity | rangeIncludes: schema:MedicalStudy" .

schema:subOrganization rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "subOrganization" ;
    rdfs:comment "A relationship between two organizations where the first includes the second, e.g., as a subsidiary. See also: the more specific 'department' property." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization | rangeIncludes: schema:Organization" .

schema:taxID rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "taxID" ;
    rdfs:comment "The Tax / Fiscal ID of the organization or person, e.g. the TIN in the US or the CIF/NIF in Spain." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:Text | subPropertyOf: schema:identifier" .

schema:telephone rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "telephone" ;
    rdfs:comment "The telephone number." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:ContactPoint, schema:Organization, schema:Person, schema:Place | rangeIncludes: schema:Text" .

schema:toRecipient rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "toRecipient" ;
    rdfs:comment "A sub property of recipient. The recipient who was directly sent the message." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Message | rangeIncludes: schema:Audience, schema:ContactPoint, schema:Organization, schema:Person | subPropertyOf: schema:recipient" .

schema:tourBookingPage rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "tourBookingPage" ;
    rdfs:comment "A page providing information on how to book a tour of some Place, such as an Accommodation or ApartmentComplex in a real estate setting, as well as other kinds of tours as appropriate." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Accommodation, schema:ApartmentComplex, schema:Place | rangeIncludes: schema:URL" .

schema:typicalTest rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "typicalTest" ;
    rdfs:comment "A medical test typically performed given this condition." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MedicalCondition | rangeIncludes: schema:MedicalTest" .

schema:unnamedSourcesPolicy rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "unnamedSourcesPolicy" ;
    rdfs:comment "For an Organization (typically a NewsMediaOrganization), a statement about policy on use of unnamed sources and the decision process required." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:NewsMediaOrganization, schema:Organization | rangeIncludes: schema:CreativeWork, schema:URL | subPropertyOf: schema:publishingPrinciples" .

schema:validFrom rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "validFrom" ;
    rdfs:comment "The date when the item becomes valid." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Certification, schema:Demand, schema:FinancialIncentive, schema:LocationFeatureSpecification, schema:MonetaryAmount, schema:Offer, schema:OpeningHoursSpecification, schema:Permit, schema:PriceSpecification | rangeIncludes: schema:Date, schema:DateTime" .

schema:validThrough rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "validThrough" ;
    rdfs:comment "The date after when the item is not valid. For example the end of an offer, salary period, or a period of opening hours." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Demand, schema:FinancialIncentive, schema:JobPosting, schema:LocationFeatureSpecification, schema:MonetaryAmount, schema:Offer, schema:OpeningHoursSpecification, schema:PriceSpecification | rangeIncludes: schema:Date, schema:DateTime" .

schema:value rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "value" ;
    rdfs:comment "The value of a QuantitativeValue (including Observation) or property value node.\\\\n\\\\n* For QuantitativeValue and MonetaryAmount, the recommended type for values is 'Number'.\\\\n* For PropertyValue, it can be 'Text', 'Number', 'Boolean', 'StructuredValue' or 'QualitativeValue'.\\\\n* Use values from 0123456789 (Unicode 'DIGIT ZERO' (U+0030) to 'DIGIT NINE' (U+0039)) rather than superficially similar Unicode symbols.\\\\n* Use '.' (Unicode 'FULL STOP' (U+002E)) rather than ',' to indicate a decimal point. Avoid using these symbols as a readability separator." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:MonetaryAmount, schema:PropertyValue, schema:QuantitativeValue | rangeIncludes: schema:Boolean, schema:Number, schema:QualitativeValue, schema:StructuredValue, schema:Text" .

schema:vatID rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "vatID" ;
    rdfs:comment "The value-added Tax ID of the organization or person with national prefix (for example IT123456789). Can also be described as iso6523Code with proper prefix." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Organization, schema:Person | rangeIncludes: schema:Text" .

schema:vendor rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "vendor" ;
    rdfs:comment "'vendor' is an earlier term for 'seller'." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:BuyAction | rangeIncludes: schema:Organization, schema:Person | subPropertyOf: schema:participant" .

schema:warrantyPromise rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "warrantyPromise" ;
    rdfs:comment "The warranty promise(s) included in the offer." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:BuyAction, schema:SellAction | rangeIncludes: schema:WarrantyPromise" .

schema:weight rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "weight" ;
    rdfs:comment "The weight of the product or person." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:OfferShippingDetails, schema:Person, schema:Product, schema:ShippingConditions, schema:VisualArtwork | rangeIncludes: schema:Mass, schema:QuantitativeValue" .

schema:workLocation rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "workLocation" ;
    rdfs:comment "A contact location for a person's place of work." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:ContactPoint, schema:Place | subPropertyOf: schema:location" .

schema:worksFor rdf:type owl:NamedIndividual , myont:ConceitoExterno ;
    rdfs:label "worksFor" ;
    rdfs:comment "Organizations that the person works for." ;
    myont:ontologiaOrigem "Schema.org" ;
    myont:tipoTermoExterno "Propriedade" ;
    myont:contextoExterno "domainIncludes: schema:Person | rangeIncludes: schema:Organization" .
