    myont:descricaoJustificativaLegal "Proteção ao Crédito (Cálculo de renda residual) e Lei 14.181/2021"^^xsd:string ;
    myont:descricaoExplicabilidade "Alta: Explicar impacto no comprometimento da renda."^^xsd:string ;
    myont:descricaoAtuacaoProxy "Proxy de religião ou culura, considerando que certas religiões ou culturas tradicionais podem se relacionar diretamente com a organização e padrões familiares."^^xsd:string .

myont:Risco_NumberOfChildrenDependents_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Penalização de famílias numerosas"@pt-br ;
    myont:descricaoRisco "Penalização de famílias numerosas"^^xsd:string ;
    myont:temNivelRisco myont:Risco_Medio ;
    myont:descricaoDemandaGovernanca "Média: Uso estrito para cálculo de renda disponível (residual)."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Risco de discriminação familiar ou de gênero (indireta)."^^xsd:string .

myont:Risco_NumberOfChildrenDependents_2 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Potencial viés contra mulheres (maternidade)."@pt-br ;
    myont:descricaoRisco "Potencial viés contra mulheres (maternidade)."^^xsd:string ;
    myont:temNivelRisco myont:Risco_Medio ;
    myont:descricaoDemandaGovernanca "Média: Uso estrito para cálculo de renda disponível (residual)."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Risco de discriminação familiar ou de gênero (indireta)."^^xsd:string .

myont:Age rdf:type owl:NamedIndividual , myont:Variavel ;
    rdfs:label "Age"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_Demografico ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_X_ProtecaoCredito , myont:Res_CMN_4966_2021 , myont:CodigoCivil_Geral ;
    myont:possuiRisco myont:Risco_Age_1 ;
    myont:baseadaEmConceitoExterno schema:birthDate ;
    myont:atuaComoProxyDe myont:PhysicalHealthStatus ;
    myont:descricaoOrigem "Institucional (Cadastro)"^^xsd:string ;
    myont:descricaoJustificativaLegal "Código Civil (Arts. 3º e 4º sobre capacidade civil), Proteção ao Crédito (Art. 7, X) e Res. CMN 4.966/2021 (expectativa de vida e provisão da operação)"^^xsd:string ;
    myont:descricaoExplicabilidade "Alta: Explicar restrições baseadas em expectativa de vida, como a inviabilidade de empréstimos a serem pagos em longos períodos. Falta de movimentação/histórico financeiro (por idade)"^^xsd:string ;
    myont:descricaoAtuacaoProxy "Proxy de etarismo e classificador de saúde. Pode ser utilizado como uma negativa não declarada relacionada à saúde."^^xsd:string .

myont:Risco_Age_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Discriminação contra idosos (risco de saúde ou de vida) ou de jovens (falta de histórico)"@pt-br ;
    myont:descricaoRisco "Discriminação contra idosos (risco de saúde ou de vida) ou de jovens (falta de histórico)"^^xsd:string ;
    myont:temNivelRisco myont:Risco_Medio ;
    myont:acionaBaseLegal myont:Estatuto_PessoaIdosa ;
    myont:descricaoDemandaGovernanca "Média: Validar curvas de risco para não penalizar indevidamente faixas etárias específicas."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Discriminação etária (Estatuto do Idoso); vedação de discriminação abusiva."^^xsd:string .

myont:Gender rdf:type owl:NamedIndividual , myont:Variavel , myont:VariavelSensivel ;
    rdfs:label "Gender"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_Demografico ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_II_ObrigacaoLegal ;
    myont:possuiRisco myont:Risco_Gender_1 , myont:Risco_Gender_2 ;
    myont:equivalenteAConceitoExterno schema:gender ;
    myont:baseadaEmConceitoExterno schema:GenderType ;
    myont:atuaComoProxyDe myont:Income ;
    myont:descricaoOrigem "Institucional (Cadastro)"^^xsd:string ;
    myont:descricaoJustificativaLegal "Cumprimento de Obrigação Legal (Identificação do cliente). Não deve ser utilizado como fato para distinção (Constituição Federal, Art. 5º, I). Somente para ações afirmativas."^^xsd:string ;
    myont:descricaoExplicabilidade "N/A: Uso apenas regulatório e que não deve ser incluído para a tomada de decisão."^^xsd:string ;
    myont:descricaoAtuacaoProxy "Proxy de renda se associado à estátistica de mulheres receberem menos e penalizar mulheres indevidamente."^^xsd:string .

myont:Risco_Gender_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Discriminação de gênero"@pt-br ;
    myont:descricaoRisco "Discriminação de gênero"^^xsd:string ;
    myont:temNivelRisco myont:Risco_Veto ;
    myont:acionaBaseLegal myont:LGPD_Art11_DadosSensiveis , myont:CF_Art5_I_IgualdadeGenero ;
    myont:descricaoDemandaGovernanca "Baixa: Uso improvável para decisão. Não recomendado."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Discriminação de gênero direta. Proibido utilizar como fato de decisão de crédito."^^xsd:string .

myont:Risco_Gender_2 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Aplicação de padrões de taxas distintos a depender do gênero. Apesar de a LGPD não classificar como dado sensível (por ser um dado público), é um dado que carrega uma vulnerabilidade implícita."@pt-br ;
    myont:descricaoRisco "Aplicação de padrões de taxas distintos a depender do gênero. Apesar de a LGPD não classificar como dado sensível (por ser um dado público), é um dado que carrega uma vulnerabilidade implícita."^^xsd:string ;
    myont:temNivelRisco myont:Risco_Veto ;
    myont:acionaBaseLegal myont:LGPD_Art11_DadosSensiveis , myont:CF_Art5_I_IgualdadeGenero ;
    myont:descricaoDemandaGovernanca "Baixa: Uso improvável para decisão. Não recomendado."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Discriminação de gênero direta. Proibido utilizar como fato de decisão de crédito."^^xsd:string .

myont:MaritalStatus rdf:type owl:NamedIndividual , myont:Variavel ;
