    myont:descricaoJustificativaLegal "LGPD: Cumprimento de Obrigação Legal."^^xsd:string ;
    myont:descricaoExplicabilidade "Média: A recusa deve ser explicada pela \"falta de histórico local de crédito\" e não pela origem do indivíduo."^^xsd:string ;
    myont:descricaoAtuacaoProxy "Proxy de raça/etnia e origem geográfica."^^xsd:string .

myont:Risco_Nationality_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Xenofobia. Dificuldade de modelar histórico para imigrantes ou refugiados recém-chegados, gerando exclusão sistêmica do sistema financeiro."@pt-br ;
    myont:descricaoRisco "Xenofobia. Dificuldade de modelar histórico para imigrantes ou refugiados recém-chegados, gerando exclusão sistêmica do sistema financeiro."^^xsd:string ;
    myont:temNivelRisco myont:Risco_Alto ;
    myont:descricaoDemandaGovernanca "Alta: Garantir que o modelo não bloqueie ou cobre taxas maiores de clientes apenas por serem estrangeiros residentes."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Violação do Art. 5º da CF, que garante direitos iguais a brasileiros e estrangeiros residentes no país."^^xsd:string .

