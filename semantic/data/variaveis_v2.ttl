    myont:descricaoAtuacaoProxy "Pode afetar pessoas solteiras e divorciadas a depender de como a variável é utilizada."^^xsd:string .

myont:Risco_MaritalStatus_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Possível viés contra determinados estados civis com base em garantias e patrimônio (solteiros, divorciados) e correlação com estabilidade."@pt-br ;
    myont:descricaoRisco "Possível viés contra determinados estados civis com base em garantias e patrimônio (solteiros, divorciados) e correlação com estabilidade."^^xsd:string ;
    myont:temNivelRisco myont:Risco_Baixo ;
    myont:acionaBaseLegal myont:CodigoCivil_Garantias ;
    myont:descricaoDemandaGovernanca "Baixa: É um dado relevante para garantias e composição de renda."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Possível discriminação com base em status familiar."^^xsd:string .

myont:Nationality rdf:type owl:NamedIndividual , myont:Variavel ;
    rdfs:label "Nationality / Foreign Worker Status (Nacionalidade)"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_Demografico ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_II_ObrigacaoLegal ;
    myont:possuiRisco myont:Risco_Nationality_1 ;
