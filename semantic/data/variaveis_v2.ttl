@prefix myont: <https://ontologia.governanca.credito/myont#> .
@prefix schema: <https://schema.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#    CATEGORIAS TEMÁTICAS (DECISÃO 08)
#################################################################

myont:Cat_Socioeconomico rdf:type owl:NamedIndividual , myont:Categoria ;
    rdfs:label "Socioeconômico"@pt-br ;
    myont:slugCategoria "socioeconomico"^^xsd:string ;
    myont:descricaoCategoria "Variáveis socioeconômicas de renda, patrimônio, ocupação e estrutura familiar."^^xsd:string .

myont:Cat_Demografico rdf:type owl:NamedIndividual , myont:Categoria ;
    rdfs:label "Demográfico"@pt-br ;
    myont:slugCategoria "demografico"^^xsd:string ;
    myont:descricaoCategoria "Atributos demográficos e cadastrais protegidos contra discriminação."^^xsd:string .

myont:Cat_InstitucionalFinanceiro rdf:type owl:NamedIndividual , myont:Categoria ;
    rdfs:label "Institucional e Financeiro"@pt-br ;
    myont:slugCategoria "institucional-e-financeiro"^^xsd:string ;
    myont:descricaoCategoria "Histórico de crédito, relacionamento bancário, saldo e compromissos financeiros."^^xsd:string .

myont:Cat_ValoresAtitudesComportamento rdf:type owl:NamedIndividual , myont:Categoria ;
    rdfs:label "Valores, Atitudes e Comportamento"@pt-br ;
    myont:slugCategoria "valores-atitudes-e-comportamento"^^xsd:string ;
    myont:descricaoCategoria "Preferências de consumo, letramento financeiro, atitudes e padrões comportamentais."^^xsd:string .

myont:Cat_Personalidade rdf:type owl:NamedIndividual , myont:Categoria ;
    rdfs:label "Personalidade"@pt-br ;
    myont:slugCategoria "personalidade"^^xsd:string ;
    myont:descricaoCategoria "Traços psicológicos, psicométricos e comportamentais avaliados com cautela regulatória."^^xsd:string .

myont:Cat_Situacional rdf:type owl:NamedIndividual , myont:Categoria ;
    rdfs:label "Situacional"@pt-br ;
    myont:slugCategoria "situacional"^^xsd:string ;
    myont:descricaoCategoria "Eventos adversos e choques situacionais na vida do titular."^^xsd:string .

myont:Cat_Educacional rdf:type owl:NamedIndividual , myont:Categoria ;
    rdfs:label "Educacional"@pt-br ;
    myont:slugCategoria "educacional"^^xsd:string ;
    myont:descricaoCategoria "Formação acadêmica, área de estudo e histórico educacional."^^xsd:string .

myont:Cat_Macroeconomico rdf:type owl:NamedIndividual , myont:Categoria ;
    rdfs:label "Macroeconômico"@pt-br ;
    myont:slugCategoria "macroeconomico"^^xsd:string ;
    myont:descricaoCategoria "Indicadores econômicos agregados e variáveis de contexto macro."^^xsd:string .

myont:Cat_Saude rdf:type owl:NamedIndividual , myont:Categoria ;
    rdfs:label "Saúde"@pt-br ;
    myont:slugCategoria "saude"^^xsd:string ;
    myont:descricaoCategoria "Indicadores de saúde física e mental (dados pessoais sensíveis sob LGPD Art. 11)."^^xsd:string .

myont:Cat_DadosAlternativos rdf:type owl:NamedIndividual , myont:Categoria ;
    rdfs:label "Dados Alternativos"@pt-br ;
    myont:slugCategoria "dados-alternativos"^^xsd:string ;
    myont:descricaoCategoria "Metadados digitais, redes sociais, geolocalização e comportamento em dispositivos."^^xsd:string .

myont:Cat_FinanceiroCorporativoPJ rdf:type owl:NamedIndividual , myont:Categoria ;
    rdfs:label "Financeiro Corporativo (PJ)"@pt-br ;
    myont:slugCategoria "financeiro-corporativo-pj"^^xsd:string ;
    myont:descricaoCategoria "Indicadores contábeis e financeiros de pessoa jurídica."^^xsd:string .

#################################################################
#    CATÁLOGO V2 (VARIÁVEIS + NÓS myont:Risco DESMEMBRADOS)
#################################################################

myont:Income rdf:type owl:NamedIndividual , myont:Variavel ;
    rdfs:label "Income"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_Socioeconomico ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_X_ProtecaoCredito , myont:LGPD_Art7_V_ExecucaoContrato , myont:Lei_14181_2021_Superendividamento ;
    myont:possuiRisco myont:Risco_Income_1 ;
    myont:baseadaEmConceitoExterno schema:MonetaryAmount , schema:baseSalary ;
    myont:descricaoOrigem "Titular / SCR / Bureaus"^^xsd:string ;
    myont:descricaoJustificativaLegal "Proteção ao Crédito (Art. 7, X), Execução de Contrato e Lei 14.181/2021 (Art. 54-D)"^^xsd:string ;
    myont:descricaoExplicabilidade "Alta: Fundamental para justificar o cálculo de comprometimento de renda."^^xsd:string ;
    myont:descricaoAtuacaoProxy "Proxy com viéses de exclusão de renda não comprovada formalmente, podendo excluir população de baixa renda mesmo com capacidade de pagamento real, mas não documental."^^xsd:string .

myont:Risco_Income_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Ignorar renda informal ou sazonal pode gerar viés de exclusão contra autônomos."@pt-br ;
    myont:descricaoRisco "Ignorar renda informal ou sazonal pode gerar viés de exclusão contra autônomos."^^xsd:string ;
    myont:temNivelRisco myont:Risco_Alto ;
    myont:acionaBaseLegal myont:Lei_14181_2021_Superendividamento ;
    myont:descricaoDemandaGovernanca "Alta: Monitoramento de consistência entre renda declarada e renda movimentada (Open Finance)."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Base para defesas em casos de superendividamento."^^xsd:string .

myont:FamilyIncome rdf:type owl:NamedIndividual , myont:Variavel ;
    rdfs:label "Family income"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_Socioeconomico ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_X_ProtecaoCredito , myont:LGPD_Art7_V_ExecucaoContrato , myont:Lei_14181_2021_Superendividamento ;
    myont:possuiRisco myont:Risco_FamilyIncome_1 ;
    myont:baseadaEmConceitoExterno schema:MonetaryAmount ;
    myont:descricaoOrigem "Titular / Parceiro / Open Finance"^^xsd:string ;
    myont:descricaoJustificativaLegal "Proteção ao Crédito (Art. 7, X), Execução de Contrato, Lei 14.181/2021 (Art. 54-D)"^^xsd:string ;
    myont:descricaoExplicabilidade "Alta: O cliente deve entender claramente como sua renda impacta o limite aprovado."^^xsd:string .

myont:Risco_FamilyIncome_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Reforço de desigualdade por penalizar rendas variáveis/informais; elitismo."@pt-br ;
    myont:descricaoRisco "Reforço de desigualdade por penalizar rendas variáveis/informais; elitismo."^^xsd:string ;
    myont:temNivelRisco myont:Risco_Alto ;
    myont:descricaoDemandaGovernanca "Alta: Verificar comprovação documental para evitar fraude e gaantir precisão na capacidade de pagamento."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Risco de exclusão econômica injustificada se a renda informal não for considerada."^^xsd:string .

myont:ParentsIncome rdf:type owl:NamedIndividual , myont:Variavel ;
    rdfs:label "Parents’ income"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_Socioeconomico ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_X_ProtecaoCredito , myont:CodigoCivil_Geral ;
    myont:possuiRisco myont:Risco_ParentsIncome_1 , myont:Risco_ParentsIncome_2 ;
    myont:baseadaEmConceitoExterno schema:MonetaryAmount , schema:parent ;
    myont:descricaoOrigem "Titular / Parceiro / Bureaus"^^xsd:string ;
    myont:descricaoJustificativaLegal "Proteção ao Crédito (Art. 7, X) e Código Civil (Fiança, Aval)"^^xsd:string ;
    myont:descricaoExplicabilidade "Baixa: Irrelevante para o risco do titular, salvo garantia."^^xsd:string .

myont:Risco_ParentsIncome_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Baixa mobilidade social"@pt-br ;
    myont:descricaoRisco "Baixa mobilidade social"^^xsd:string ;
    myont:temNivelRisco myont:Risco_Baixo ;
    myont:descricaoDemandaGovernanca "Baixa: Apenas relevante se os pais forem garantidores solidários."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Reforço de desigualdade intergeracional."^^xsd:string .

myont:Risco_ParentsIncome_2 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Favorecimento de herdeiros."@pt-br ;
    myont:descricaoRisco "Favorecimento de herdeiros."^^xsd:string ;
    myont:temNivelRisco myont:Risco_Baixo ;
    myont:descricaoDemandaGovernanca "Baixa: Apenas relevante se os pais forem garantidores solidários."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Reforço de desigualdade intergeracional."^^xsd:string .

myont:Wealth rdf:type owl:NamedIndividual , myont:Variavel ;
    rdfs:label "Wealth"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_Socioeconomico ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_X_ProtecaoCredito , myont:CodigoCivil_Garantias ;
    myont:possuiRisco myont:Risco_Wealth_1 , myont:Risco_Wealth_2 ;
    myont:equivalenteAConceitoExterno schema:netWorth ;
    myont:baseadaEmConceitoExterno schema:MonetaryAmount ;
    myont:descricaoOrigem "Titular"^^xsd:string ;
    myont:descricaoJustificativaLegal "Proteção ao Crédito (Art. 7, X) e Garantias - Código Civil (Art. 391)"^^xsd:string ;
    myont:descricaoExplicabilidade "Média: Explicar como ativos entram como redutores de risco."^^xsd:string ;
    myont:descricaoAtuacaoProxy "Reforço de determinadas desigualdades, principalmente para quem tem renda, mas não possui ativos acumulados."^^xsd:string .

myont:Risco_Wealth_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Favorecimento de classes alta"@pt-br ;
    myont:descricaoRisco "Favorecimento de classes alta"^^xsd:string ;
    myont:temNivelRisco myont:Risco_Medio ;
    myont:descricaoDemandaGovernanca "Média: Validação de liquidez dos ativos declarados."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Reforço de desiguldades patrimoniais estruturais."^^xsd:string .

myont:Risco_Wealth_2 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Viés de acumulação histórica"@pt-br ;
    myont:descricaoRisco "Viés de acumulação histórica"^^xsd:string ;
    myont:temNivelRisco myont:Risco_Medio ;
    myont:descricaoDemandaGovernanca "Média: Validação de liquidez dos ativos declarados."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Reforço de desiguldades patrimoniais estruturais."^^xsd:string .

myont:TotalFinancialAssets rdf:type owl:NamedIndividual , myont:Variavel ;
    rdfs:label "Total financial assets"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_InstitucionalFinanceiro ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_X_ProtecaoCredito ;
    myont:possuiRisco myont:Risco_TotalFinancialAssets_1 ;
    myont:baseadaEmConceitoExterno schema:netWorth , schema:MonetaryAmount ;
    myont:descricaoOrigem "Institucional / Open Finance"^^xsd:string ;
    myont:descricaoJustificativaLegal "Proteção ao Crédito (Art. 7º, X)"^^xsd:string ;
    myont:descricaoExplicabilidade "Média: Ativos como mitigadores de risco."^^xsd:string .

myont:Risco_TotalFinancialAssets_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Favorecimento de clientes de alta renda."@pt-br ;
    myont:descricaoRisco "Favorecimento de clientes de alta renda."^^xsd:string ;
    myont:temNivelRisco myont:Risco_Alto ;
    myont:descricaoDemandaGovernanca "Alta: Validação de liquidez dos ativos para recuperação de crédito."^^xsd:string .

myont:HomeOwnership rdf:type owl:NamedIndividual , myont:Variavel ;
    rdfs:label "Home ownership"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_Socioeconomico ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_X_ProtecaoCredito , myont:CodigoCivil_Garantias ;
    myont:possuiRisco myont:Risco_HomeOwnership_1 ;
    myont:baseadaEmConceitoExterno schema:Residence , schema:homeLocation ;
    myont:descricaoOrigem "Titular / Cartórios"^^xsd:string ;
    myont:descricaoJustificativaLegal "Proteção ao Crédito (Art. 7, X) e Garantias, Código Civil (Arts. 1.419 a 1.510)"^^xsd:string ;
    myont:descricaoExplicabilidade "Média: Demonstrar nexo entre estabilidade de moradia e risco."^^xsd:string ;
    myont:descricaoAtuacaoProxy "Proxy de raça e classe, considerando populações marginalizadas que vivem em áreas informais ou de aluguel. Exclusão de grupos raciais ou de periferias."^^xsd:string .

myont:Risco_HomeOwnership_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Penalização de quem paga aluguel ou vive em áreas informais (sem escritura)"@pt-br ;
    myont:descricaoRisco "Penalização de quem paga aluguel ou vive em áreas informais (sem escritura)"^^xsd:string ;
    myont:temNivelRisco myont:Risco_Medio ;
    myont:descricaoDemandaGovernanca "Média: Verificar se a posse do imóvel tem correlação real com adimplência no modelo."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Potencial discriminação indireta baseada em CEP ou regularização fundiária."^^xsd:string .

myont:Occupation rdf:type owl:NamedIndividual , myont:Variavel ;
    rdfs:label "Occupation"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_Socioeconomico ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_X_ProtecaoCredito , myont:Res_CMN_4966_2021 ;
    myont:possuiRisco myont:Risco_Occupation_1 ;
    myont:equivalenteAConceitoExterno schema:Occupation , schema:hasOccupation ;
    myont:atuaComoProxyDe myont:Gender ;
    myont:descricaoOrigem "Titular"^^xsd:string ;
    myont:descricaoJustificativaLegal "Proteção ao Crédito (Art. 7, X) e Res. CMN 4.966/2021 (Art. 51)"^^xsd:string ;
    myont:descricaoExplicabilidade "Alta: Cliente deve entender como a estabilidade da profissão afeta o risco."^^xsd:string ;
    myont:descricaoAtuacaoProxy "Proxy de gênero e classe, considerando que determinadas profissões podem estar mais relacionadas a determinado gênro ou raça, assim como à desigualdades estruturais de classe."^^xsd:string .

myont:Risco_Occupation_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Discriminação de profissões estigmatizadas ou informais."@pt-br ;
    myont:descricaoRisco "Discriminação de profissões estigmatizadas ou informais."^^xsd:string ;
    myont:temNivelRisco myont:Risco_Alto ;
    myont:descricaoDemandaGovernanca "Alta: Monitorar se certas profissões estão sendo bloqueadas indevidamente."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Risco de discriminação laboral."^^xsd:string .

myont:EmploymentStatus rdf:type owl:NamedIndividual , myont:Variavel ;
    rdfs:label "Employment status"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_Socioeconomico ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_X_ProtecaoCredito , myont:Res_CMN_4966_2021 ;
    myont:possuiRisco myont:Risco_EmploymentStatus_1 ;
    myont:baseadaEmConceitoExterno schema:employmentType , schema:EmployeeRole ;
    myont:atuaComoProxyDe myont:Gender ;
    myont:descricaoOrigem "Titular / Institucional (Cadastro)"^^xsd:string ;
    myont:descricaoJustificativaLegal "Proteção ao Crédito (Art. 7, X) e Res. CMN 4.966/2021 (Art. 51)"^^xsd:string ;
    myont:descricaoExplicabilidade "Alta: Justificar o peso da \"estabilidade\" no score."^^xsd:string ;
    myont:descricaoAtuacaoProxy "Proxy de gênero e classe, considerando que determinadas profissões podem estar mais relacionadas a determinado gênro ou raça, assim como à desigualdades estruturais de classe."^^xsd:string .

myont:Risco_EmploymentStatus_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Penalização de desempregados ou autônomos momentâneos."@pt-br ;
    myont:descricaoRisco "Penalização de desempregados ou autônomos momentâneos."^^xsd:string ;
    myont:temNivelRisco myont:Risco_Alto ;
    myont:descricaoDemandaGovernanca "Alta: Considerar a volatilidade da renda, não apenas o vínculo formal."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Exclusão de trabalhadores da economia gig (uberização)."^^xsd:string .

myont:LengthOfEmployment rdf:type owl:NamedIndividual , myont:Variavel ;
    rdfs:label "Length of employment"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_Socioeconomico ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_X_ProtecaoCredito , myont:Res_CMN_4966_2021 ;
    myont:possuiRisco myont:Risco_LengthOfEmployment_1 ;
    myont:baseadaEmConceitoExterno schema:monthsOfExperience ;
    myont:atuaComoProxyDe myont:Age , myont:PhysicalHealthStatus , myont:Gender ;
    myont:descricaoOrigem "Titular / Institucional (Cadastro)"^^xsd:string ;
    myont:descricaoJustificativaLegal "Proteção ao Crédito (Art. 7, X) e Res. CMN 4.966/2021 (Consistência da capacidade financeira)"^^xsd:string ;
    myont:descricaoExplicabilidade "Média: Pode possuir correlação com economias diretas do cliente, incluindo fluxo de caixa."^^xsd:string ;
    myont:descricaoAtuacaoProxy "Proxy de idade, saúde e gênero por penalizar jovens, pausas na carreira por motivos de saúde ou de maternidade."^^xsd:string .

myont:Risco_LengthOfEmployment_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Viés contra jovens ou profissionais em transição de carreira frequente."@pt-br ;
    myont:descricaoRisco "Viés contra jovens ou profissionais em transição de carreira frequente."^^xsd:string ;
    myont:temNivelRisco myont:Risco_Medio ;
    myont:descricaoDemandaGovernanca "Média: Avaliar estabilidade vs. empregabilidade."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Pode afetar desproporcionalmente gerações mais novas."^^xsd:string .

myont:Education rdf:type owl:NamedIndividual , myont:Variavel ;
    rdfs:label "Education"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_Socioeconomico ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_IX_InteresseLegitimo , myont:Res_CMN_4966_2021 ;
    myont:possuiRisco myont:Risco_Education_1 , myont:Risco_Education_2 ;
    myont:equivalenteAConceitoExterno schema:educationalLevel ;
    myont:baseadaEmConceitoExterno schema:EducationalOccupationalCredential , schema:alumniOf ;
    myont:atuaComoProxyDe myont:Income ;
    myont:descricaoOrigem "Titular / Parceiro / Institucional (Cadastro)"^^xsd:string ;
    myont:descricaoJustificativaLegal "Interesse Legítimo (com cautela) e Res. CMN 4.966/2021"^^xsd:string ;
    myont:descricaoExplicabilidade "Média: Nexo entre formação e empregabilidade futura."^^xsd:string ;
    myont:descricaoAtuacaoProxy "Proxy de raça e de renda graças ao acesso desigual à educação por pessoas PPI ou de baixa renda."^^xsd:string .

myont:Risco_Education_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Alto Risco: Atuar como proxy de renda ou classe social"@pt-br ;
    myont:descricaoRisco "Alto Risco: Atuar como proxy de renda ou classe social"^^xsd:string ;
    myont:temNivelRisco myont:Risco_Alto ;
    myont:descricaoDemandaGovernanca "Média: Monitorar estritamente para garantir que não substitua a análise de renda real"^^xsd:string ;
    myont:descricaoImplicacaoLegal "Reforço de desigualdades de acesso à educação; potencial discriminação indireta."^^xsd:string .

myont:Risco_Education_2 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Elitismo acadêmico"@pt-br ;
    myont:descricaoRisco "Elitismo acadêmico"^^xsd:string ;
    myont:temNivelRisco myont:Risco_Medio ;
    myont:descricaoDemandaGovernanca "Média: Monitorar estritamente para garantir que não substitua a análise de renda real"^^xsd:string ;
    myont:descricaoImplicacaoLegal "Reforço de desigualdades de acesso à educação; potencial discriminação indireta."^^xsd:string .

myont:NumberOfChildrenDependents rdf:type owl:NamedIndividual , myont:Variavel ;
    rdfs:label "Number of children/dependents"@en ;
    myont:temStatusCuradoria myont:Status_Auditada ;
    myont:pertenceACategoria myont:Cat_Socioeconomico ;
    myont:autorizadaPorBaseLegal myont:LGPD_Art7_X_ProtecaoCredito , myont:Lei_14181_2021_Superendividamento ;
