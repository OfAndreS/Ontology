myont:Risco_GeographicalLocations_1 rdf:type owl:NamedIndividual , myont:Risco ;
    rdfs:label "Rastrear a rotina física do cidadão. Pune com taxas de juros maiores quem dorme ou trabalha em áreas de risco, periferias ou favelas (Redlining Geográfico)."@pt-br ;
    myont:descricaoRisco "Rastrear a rotina física do cidadão. Pune com taxas de juros maiores quem dorme ou trabalha em áreas de risco, periferias ou favelas (Redlining Geográfico)."^^xsd:string ;
    myont:temNivelRisco myont:Risco_Maximo ;
    myont:descricaoDemandaGovernanca "Máxima: Segregação de Dados (Ring-Fencing). O GPS coletado pelo App do banco só pode ser usado momentaneamente pelo Motor Antifraude, nunca guardado para treinar modelos IRB de risco de crédito."^^xsd:string ;
    myont:descricaoImplicacaoLegal "Infração ao Princípio da Não-Discriminação (LGPD) e passível de graves Danos Morais Coletivos por discriminação territorial."^^xsd:string .
