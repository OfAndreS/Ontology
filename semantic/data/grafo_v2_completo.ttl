    myont:tipoDispositivo "Inciso" ;
    myont:pertenceAInstrumento myont:Norma_LGPD .

myont:LGPD_Art7_X_ProtecaoCredito rdf:type owl:NamedIndividual , myont:DispositivoLegal ;
    rdfs:label "LGPD Art. 7º, X - Proteção ao Crédito"@pt-br ;
