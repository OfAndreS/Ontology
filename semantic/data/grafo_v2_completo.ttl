    rdfs:label "Lei do Superendividamento (Lei nº 14.181/2021)"@pt-br ;
    myont:tipoInstrumento "Lei" .

myont:Lei_14181_2021_Superendividamento rdf:type owl:NamedIndividual , myont:DispositivoLegal ;
