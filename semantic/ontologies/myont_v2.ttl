myont:Res_CMN_4966_2021 rdf:type owl:NamedIndividual , myont:InstrumentoNormativo ;
    rdfs:label "Resolução CMN nº 4.966/2021"@pt-br ;
    myont:tipoInstrumento "Resolução" .

myont:Normas_BACEN rdf:type owl:NamedIndividual , myont:InstrumentoNormativo ;
    rdfs:label "Normas de Flexibilização de Crédito (BACEN)"@pt-br ;
    myont:tipoInstrumento "Regulação Setorial" .

### Marco Civil da Internet e Estatuto da Pessoa Idosa
myont:MarcoCivil_Internet rdf:type owl:NamedIndividual , myont:InstrumentoNormativo ;
    rdfs:label "Marco Civil da Internet (Lei nº 12.965/2014)"@pt-br ;
    myont:tipoInstrumento "Lei" .

myont:Estatuto_PessoaIdosa rdf:type owl:NamedIndividual , myont:InstrumentoNormativo ;
    rdfs:label "Estatuto da Pessoa Idosa (Lei nº 10.741/2003)"@pt-br ;
    myont:tipoInstrumento "Lei" .
