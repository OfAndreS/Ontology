# PostgreSQL
POSTGRES_DB=myont_platform
POSTGRES_USER=myont
POSTGRES_PASSWORD=myont_dev_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://myont:myont_dev_password@localhost:5433/myont_platform

# Apache Jena Fuseki
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=myont
FUSEKI_USER=admin
FUSEKI_PASSWORD=admin
FUSEKI_ADMIN_PASSWORD=admin

# Auth / JWT
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=admin@governanca.local
ADMIN_DEFAULT_PASSWORD=admin123

# Storage
UPLOAD_DIR=uploads/laws
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
